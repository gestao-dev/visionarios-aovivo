---
import Mono from './Mono.astro';

// Duas faixas douradas em X (nós 2722:1942 e 2722:2015). Concêntricas e com
// rotações opostas e simétricas: assim o cruzamento cai no centro da tela, não
// perto da borda. Cada lista é repetida o bastante para não sobrar vão.
const cima = ['Vagas limitadas', 'Primeira edição', 'Presencial'];
const baixo = ['2 dias', 'São Paulo', 'Ao vivo'];
const repetir = (xs: string[], n = 8) => Array.from({ length: n }, () => xs).flat();
---

<div class="bands" aria-hidden="true">
  <div class="band band--up">
    <div class="band__track">
      {repetir(cima).map((t) => (
        <span class="band__item">{t}<Mono size={26} class="band__sep" /></span>
      ))}
    </div>
  </div>

  <div class="band band--down">
    <div class="band__track band__track--rev">
      {repetir(baixo).map((t) => (
        <span class="band__item">{t}<Mono size={26} class="band__sep" /></span>
      ))}
    </div>
  </div>
</div>

<style>
  /* As duas faixas dividem a mesma célula: mesmo centro, rotações opostas,
     cruzamento no meio da tela. Ficam fora da hero porque, no arquivo original,
     atravessam a fronteira entre as seções. */
  .bands {
    position: relative;
    z-index: 5;
    display: grid;
    margin-inline: -14%;
    margin-top: clamp(-9rem, -15vw, -5rem);
    margin-bottom: clamp(3rem, 7vw, 6rem);
    pointer-events: none;
  }

  .band {
    grid-area: 1 / 1;
    overflow: hidden;
    padding-block: clamp(0.5rem, 1.3vw, 0.9rem);
    background: linear-gradient(97deg, #b58f3c 0%, var(--gold) 18%, var(--gold-flare) 52%, var(--gold) 82%, #b58f3c 100%);
    box-shadow: 0 14px 40px -14px #00000099;
  }
  .band--up   { transform: rotate(-3.2deg); }
  .band--down { transform: rotate(3.2deg); z-index: 1; }

  .band__track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .band__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.2rem, 2.6vw, 2.2rem);
    padding-right: clamp(1.2rem, 2.6vw, 2.2rem);
    color: var(--navy);
    font-size: clamp(1.05rem, 2.6vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .band__sep { flex: none; opacity: 0.85; }

  /* O movimento é ligado à rolagem da página, não ao relógio. */
  @media (prefers-reduced-motion: no-preference) {
    .band__track {
      animation: run-left linear both;
      animation-timeline: scroll(root block);
    }
    .band__track--rev { animation-name: run-right; }

    /* Sem timeline de rolagem, o laço roda no tempo — mesma leitura, sem depender
       de um recurso que nem todo navegador tem. */
    @supports not (animation-timeline: scroll(root block)) {
      .band__track { animation: run-left 34s linear infinite; }
      .band__track--rev { animation: run-right 34s linear infinite; }
    }
  }

  @keyframes run-left  { to { transform: translateX(-50%); } }
  @keyframes run-right { from { transform: translateX(-50%); } to { transform: none; } }
</style>
