---
/**
 * Ícones autorais, traço único de 1.5 e grade de 24.
 * Substituem os emoji da página antiga sem tocar em uma palavra da copy:
 * a palavra é conteúdo, o emoji era dispositivo visual — e emoji não é
 * sistema de ícones.
 */
const { name, size = 20, class: klass = '' } = Astro.props;

const paths = {
  // 📅
  calendar: `<rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 10h18M8 3v4M16 3v4"/>`,
  // 📍
  pin: `<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>`,
  // ⏳
  hourglass: `<path d="M7 3h10M7 21h10"/><path d="M8 3v3.2c0 1.9 4 3.6 4 5.8s-4 3.9-4 5.8V21"/><path d="M16 3v3.2c0 1.9-4 3.6-4 5.8s4 3.9 4 5.8V21"/>`,
  // 🧱
  wall: `<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 9.6h18M3 14.4h18M9 5v4.6M15 9.6v4.8M9 14.4V19"/>`,
  // 🔑
  key: `<circle cx="8" cy="12" r="4"/><path d="M12 12h9M18 12v3.5M15.2 12v2.5"/>`,
  // ★
  star: `<path d="m12 3.6 2.6 5.5 5.9.8-4.3 4.2 1 6-5.2-2.8L6.8 20l1-6-4.3-4.2 5.9-.8L12 3.6Z"/>`,
  // 🎁
  gift: `<rect x="3" y="9.5" width="18" height="11" rx="1.2"/><path d="M3 13.6h18M12 9.5V20.5"/><path d="M12 9.5S10.6 5 8.4 5a2.2 2.2 0 0 0 0 4.5Z"/><path d="M12 9.5S13.4 5 15.6 5a2.2 2.2 0 0 1 0 4.5Z"/>`,
  // ⏱️
  stopwatch: `<circle cx="12" cy="13.5" r="7.5"/><path d="M12 9.6v4h2.8M9.5 2.5h5M12 6V2.9M18.6 7.4l1.6-1.6"/>`,
  // 🎬
  clapper: `<path d="M3 9.5h18v10.2a1.3 1.3 0 0 1-1.3 1.3H4.3A1.3 1.3 0 0 1 3 19.7Z"/><path d="M3.4 9.5 2.6 6l17.6-2.6.8 3.5Z"/><path d="m8.2 4.6.9 4.2M13.6 3.8l.9 4.2"/>`,
  check: `<path d="m4.5 12.6 4.8 4.6L19.5 6.8"/>`,
  arrow: `<path d="M4 12h15.5M13.4 6.2 19.8 12l-6.4 5.8"/>`,
  shield: `<path d="M12 2.8 4.8 5.6v6.1c0 4.3 3 7.9 7.2 9.5 4.2-1.6 7.2-5.2 7.2-9.5V5.6Z"/><path d="m8.9 12 2.2 2.2 4-4.4"/>`,
  // As 4 fases do método
  mind: `<path d="M14.5 20.5v-2.2a3 3 0 0 1 1.2-2.4A7 7 0 0 0 12 3.2a7 7 0 0 0-3.7 12.7 3 3 0 0 1 1.2 2.4v2.2"/><path d="M9.5 20.5h5M10 12l1.6 1.6L14.6 10"/>`,
  users: `<circle cx="9" cy="8" r="3.2"/><path d="M2.8 20.2a6.2 6.2 0 0 1 12.4 0"/><path d="M16.2 5.2a3.2 3.2 0 0 1 0 5.9M17.6 14.6a6.2 6.2 0 0 1 3.6 5.6"/>`,
  cpu: `<rect x="7" y="7" width="10" height="10" rx="1.6"/><path d="M4 10h3M4 14h3M17 10h3M17 14h3M10 4v3M14 4v3M10 17v3M14 17v3"/>`,
  chart: `<path d="M4 20h16"/><path d="M7 20v-5.5M12 20V7.5M17 20v-9"/>`,
  play: `<circle cx="12" cy="12" r="9"/><path d="M10.2 8.7 15.6 12l-5.4 3.3Z"/>`,
};
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
