---
import { Image, getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import ticket from '../../assets/ticket-lote-zero.png';
import ticketMobile from '../../assets/ticket-lote-zero-mobile.png';

const vantagens = [
  { icon: 'star',      texto: 'O menor preço do evento: abre antes de todos os lotes, por 48h, e não volta.' },
  { icon: 'gift',      texto: 'Bônus físico exclusivo pra quem garantir nas primeiras 48h.' },
  { icon: 'stopwatch', texto: 'Prioridade na abertura: você é avisado primeiro, antes da lista pública.' },
  { icon: 'clapper',   texto: 'Bastidores: palestrantes e novidades em primeira mão.' },
];

const ticketLargo = await getImage({ src: ticket, widths: [430, 858], format: 'webp', quality: 88 });
const ticketEstreito = await getImage({ src: ticketMobile, widths: [430, 700, 1024], format: 'webp', quality: 90 });
---

<!-- ══ Lote Zero ══ -->
<section class="eyebrow-free" aria-labelledby="t-vant">
  <span class="glow glow--gold g-center" aria-hidden="true"></span>
  <div class="shell center measure-wide">
    <p class="over fade">Por que entrar agora</p>
    <h2 id="t-vant" class="rise">A vantagem de estar na lista</h2>
  </div>

  <div class="shell lote">
    <div class="card lote__frame rise">
      <div class="lote__art from-l">
        <picture>
          <source media="(max-width: 60rem)" type="image/webp"
                  srcset={ticketEstreito.srcSet.attribute} sizes="80vw" />
          <img src={ticketLargo.src} srcset={ticketLargo.srcSet.attribute} sizes="24rem"
               width={858} height={1462} loading="lazy" decoding="async"
               alt="Ingresso Lote Zero do Visionários ao Vivo, com Viviane Araújo e Marcos Paulo" />
        </picture>
      </div>

      <div class="lote__side from-r">
        <div class="lote__head stagger">
          <img class="lote__logo" src="/logo-visionarios-ao-vivo.svg"
               alt="Visionários ao Vivo" width="196" height="48" />
          <span class="tag">Lote Zero</span>
        </div>

        <ul class="perks stagger">
          {vantagens.map((v) => (
            <li><span class="medal medal--sm"><Icon name={v.icon} size={19} /></span><span>{v.texto}</span></li>
          ))}
        </ul>

        <div class="lote__act rise">
          <button class="cta cta--wide" type="button" data-open-lead>
            Quero o Lote Zero + bônus <Icon name="arrow" size={18} />
          </button>

          <div class="tick" role="timer" aria-live="off">
            <span class="tick__tag">Faltam:</span>
            <div class="tick__boxes">
              <div class="tick__box"><b data-u="d">00</b><span>DIAS</span></div>
              <div class="tick__box"><b data-u="h">00</b><span>HORAS</span></div>
              <div class="tick__box"><b data-u="m">00</b><span>MIN</span></div>
              <div class="tick__box"><b data-u="s">00</b><span>SEG</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .measure-wide { max-width: 46rem; }
  .over {
    margin-bottom: 0.77rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-flare);
  }

  /* ── Lote Zero: o ingresso à esquerda, o argumento à direita ── */
  .lote { margin-top: 3rem; max-width: 64rem; }
  .lote__frame {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.6rem);
    padding: clamp(1.1rem, 2.2vw, 1.6rem);
    align-items: stretch;
    background: linear-gradient(180deg, #02132b, #041e42);
  }
  /* A arte já é o ingresso inteiro: logo, chips e código de barras vêm nela.
     No formato alto ela cobre a altura da coluna sozinha, sem placa. */
  .lote__art { line-height: 0; }
  /* Sem raio aqui: o canto arredondado já vem no PNG. */
  .lote__art :global(img) { width: 100%; height: auto; }

  /* O conteúdo é mais baixo que o ingresso: centrado, o resto vira margem
     em cima e embaixo em vez de um buraco só no pé. */
  .lote__side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: clamp(0.2rem, 1.6vw, 1.2rem);
  }
  .lote__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .lote__logo { width: 172px; height: 42px; }

  /* Etiqueta do lote, no lugar da marca do produto na referência. */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.15rem;
    border-radius: 100px;
    background-image: linear-gradient(90deg, var(--gold) 0%, var(--gold-flare) 100%);
    color: var(--navy);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Os filetes que separam os blocos vêm da referência. */
  .perks {
    margin-top: 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--edge-lit);
    display: grid;
    gap: 1.1rem;
  }
  /* Ícone centrado na altura do texto, não colado no topo. */
  .perks li { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: center; color: var(--paper); }
  /* Medida curta de propósito: com a largura toda, um item cabe em uma linha
     e outro sobra uma palavra sozinha. Em 40ch os quatro caem em duas linhas,
     e o balance reparte cada par para não deixar viúva. */
  .perks li > span:last-child { max-width: 40ch; text-wrap: balance; }
  .medal--sm { width: 2.4rem; height: 2.4rem; border-radius: 10px; }

  .lote__act {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--edge-lit);
    text-align: center;
  }
  .lote__act .cta { width: 100%; }

  /* ── Regressivo compacto sob a ação ── */
  .tick {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.1rem;
    flex-wrap: wrap;
  }
  .tick__tag {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
  }
  .tick__boxes { display: flex; gap: 7px; }
  .tick__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 66px;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--edge-lit);
    border-radius: 6px;
    background: #5a3e361a;
    color: var(--paper);
  }
  .tick__box b { font-size: 1.25rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .tick__box span { font-size: 9px; font-weight: 400; line-height: 1.2; color: #ffffffb3; }

  @media (max-width: 60rem) {
    .lote__frame { grid-template-columns: 1fr; }
    .lote__art { width: 100%; margin-inline: auto; }
    /* A arte do ingresso já traz marca e lote: repetir os dois embaixo dela
       é dizer a mesma coisa duas vezes. */
    .lote__head { display: none; }
    .perks { margin-top: 0; padding-top: 0; border-top: 0; }
  }

  .g-center { width: 42rem; height: 26rem; top: 18%; left: 50%; transform: translateX(-50%); opacity: 0.3; }
</style>
