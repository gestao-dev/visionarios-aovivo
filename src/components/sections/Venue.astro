---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import espaco from '../../assets/espaco-varanda-rooftop.webp';

// Onde acontece: foto do espaço à esquerda, dados à direita, na composição da
// referência do cliente. Vem antes dos ingressos porque saber o lugar é a
// última informação que falta antes de decidir a compra.
const dados = [
  { icon: 'calendar', texto: '29 e 30 de Outubro · 2026', forte: true },
  { icon: 'pin',      texto: 'Espaço | Varanda Rooftop',  forte: true },
];
---

<!-- ══ O espaço ══ -->
<section class="venue eyebrow-free" aria-labelledby="t-espaco">
  <span class="glow glow--gold g-center" aria-hidden="true"></span>

  <div class="shell center measure-wide">
    <p class="over fade">Quando e onde vai acontecer</p>
    <h2 id="t-espaco" class="rise">Onde vai acontecer o <span class="hand">Visionários ao Vivo</span>?</h2>
  </div>

  <div class="shell venue__frame card rise">
    <div class="venue__art">
      <Image src={espaco} alt="Varanda Rooftop, espaço do Visionários ao Vivo em Alphaville"
             widths={[680, 1360]} sizes="(max-width: 56rem) 100vw, 34rem" quality={86} />
    </div>

    <div class="venue__side stagger">
      <img class="venue__logo" src="/logo-visionarios-ao-vivo.svg"
           alt="Visionários ao Vivo" width="196" height="48" />

      <ul class="venue__facts">
        {dados.map((d) => (
          <li class={d.forte ? 'venue__fact--strong' : ''}>
            <Icon name={d.icon} size={18} />
            <span>{d.texto}</span>
          </li>
        ))}
      </ul>

      <p class="venue__addr">
        Brascan Alphaville · Av. Andrômeda, 885 · Sala 501 a 505<br />
        Alphaville Empresarial, Barueri · SP · 06473-000
      </p>
    </div>
  </div>
</section>

<style>
  .measure-wide { max-width: 46rem; }
  .over {
    margin-bottom: 0.77rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-flare);
  }

  /* Foto e dados dividem a caixa, como na referência: a imagem sangra até a
     borda do cartão e o painel escuro segura o texto. */
  .venue__frame {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    max-width: 64rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    padding: 0;
    overflow: clip;
  }

  .venue__art { line-height: 0; }
  .venue__art :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .venue__side {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    background: var(--ground-deep);
    text-align: center;
  }
  .venue__logo { width: 172px; height: 42px; }

  .venue__facts { display: grid; gap: 1rem; }
  .venue__facts li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--paper);
    font-size: 1rem;
  }
  .venue__facts :global(svg) { color: var(--gold); flex: none; }
  .venue__fact--strong {
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* O endereço é consulta, não argumento: fica menor e atrás de um filete. */
  .venue__addr {
    padding-top: 1.4rem;
    border-top: 1px solid var(--edge-lit);
    color: var(--paper);
    font-size: 0.86rem;
    line-height: 1.6;
    opacity: 0.86;
  }

  @media (max-width: 56rem) {
    .venue__frame { grid-template-columns: 1fr; }
    .venue__art :global(img) { aspect-ratio: 3 / 2; }
  }

  .g-center { width: 42rem; height: 26rem; top: 12%; left: 50%; transform: translateX(-50%); opacity: 0.26; }
</style>
