---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import ingressoRoyal from '../../assets/ingresso-royal.png';
import ingressoGold from '../../assets/ingresso-gold.png';

// Copy e valores idênticos ao public/lp/index.html (produção), só com o
// tratamento visual do sistema novo. Links de pagamento e WhatsApp mantidos.
const whatsapp =
  'https://wa.me/5513981810880?text=Ol%C3%A1%2C%20vim%20do%20site%20do%20Vision%C3%A1rios%20ao%20vivo%20e%20quero%20mais%20informa%C3%A7%C3%B5es%20sobre%20os%20pacotes%20de%20ingressos%20com%20desconto.';

const ingressos = [
  {
    nome: 'Royal',
    sub: 'Ingresso · Lote Zero',
    arte: ingressoRoyal,
    preco: '397',
    centavos: '00',
    pagamento: 'https://clkdmg.site/pay/lote-zero-vav',
    inclHead: 'O que está incluso',
    incl: ['Acesso aos 2 dias de evento', 'Material de apoio', 'Coffee break', 'Certificado de participação'],
    destaque: false,
  },
  {
    nome: 'Gold',
    sub: 'Ingresso · Lote Zero · VIP',
    arte: ingressoGold,
    preco: '997',
    centavos: '00',
    pagamento: 'https://clkdmg.site/pay/lote-zero-gold',
    inclHead: 'Tudo do Royal, mais:',
    incl: [
      'Jantar exclusivo no dia anterior com Marcos e Viviane',
      'Lounge VIP durante o evento',
      'Fotógrafa de retratos exclusiva',
      'Credenciamento prioritário',
      'Assentos reservados na frente',
      'Press kit VIP exclusivo',
    ],
    destaque: true,
  },
];
---

<!-- ══ Ingressos ══ -->
<section id="ingressos" class="eyebrow-free" aria-labelledby="t-ing">
  <span class="glow glow--gold g-center" aria-hidden="true"></span>
  <div class="shell center measure-wide">
    <p class="over fade">Garanta sua vaga</p>
    <h2 id="t-ing" class="rise">Escolha seu ingresso</h2>
    <p class="sec-lede measure center rise">
      Preço de <span class="grad">Lote Zero</span>: o menor que esse evento vai ter. Vagas limitadas.
    </p>
  </div>

  <div class="shell tickets stagger">
    {ingressos.map((t) => (
      <div class={`card tk ${t.destaque ? 'tk--gold' : ''}`}>
        {t.destaque && <span class="tk__flag">Experiência completa</span>}

        <div class="tk__art">
          <Image src={t.arte} alt={`Ingresso ${t.nome} do Visionários ao Vivo`}
                 widths={[430, 860]} sizes="(max-width: 54rem) 80vw, 26rem" quality={90} />
        </div>

        <div class="tk__incl">
          <p class="tk__inclh">{t.inclHead}</p>
          <ul>
            {t.incl.map((i) => (
              <li><Icon name="check" size={15} />{i}</li>
            ))}
          </ul>
        </div>

        <p class="tk__price">
          <span class="tk__cur">R$</span>{t.preco}<span class="tk__cents">,{t.centavos}</span>
        </p>
        <p class="tk__vagas">Vagas limitadas</p>

        <a class={`cta cta--wide ${t.destaque ? '' : 'cta--royal'}`} href={t.pagamento}>
          Garantir 1 ingresso <Icon name="arrow" size={18} />
        </a>

        <div class="tk__btns">
          <a class="tk__btn2" href={whatsapp}>2 a 4 ingressos <span>15% OFF</span></a>
          <a class="tk__btn2" href={whatsapp}>5+ ingressos <span>20% OFF</span></a>
        </div>

        <p class="tk__note">Grupos de 2+ ingressos: atendimento consultivo com o nosso time no WhatsApp.</p>

        <img class="tk__flags" src="/bandeiras-cartao.svg" alt="Bandeiras de cartão aceitas"
             width="269" height="47" loading="lazy" decoding="async" />
      </div>
    ))}
  </div>

  <div class="shell">
    <p class="assure rise">
      <Icon name="shield" size={16} />
      Compra 100% segura · <b>7 dias de garantia</b>: se desistir em até 7 dias da compra,
      devolvemos 100% do valor (direito de arrependimento, conforme o Código de Defesa do Consumidor).
    </p>
  </div>
</section>

<style>
  .measure-wide { max-width: 46rem; }
  .over {
    margin-bottom: 0.77rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-flare);
  }
  .assure { color: var(--paper); }
  .assure b { color: var(--gold-lift); font-weight: 700; }

  .tickets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    max-width: 62rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    align-items: start;
  }
  @media (max-width: 54rem) {
    .tickets { grid-template-columns: 1fr; max-width: 30rem; }
  }

  .tk {
    position: relative;
    padding: clamp(1.6rem, 3vw, 2.2rem);
    /* Royal: azul chapado, sem degradê. */
    background: var(--ground);
  }

  /* Gold: recebe o degradê que era do Royal, e a borda que anda. */
  @property --tk-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .tk--gold {
    border: 1px solid transparent;
    /* padding-box guarda a superfície, border-box recebe a luz que gira. */
    background:
      linear-gradient(180deg, #07295a, #031733) padding-box,
      conic-gradient(
        from var(--tk-angle),
        /* Base a 50%: a borda parada some pela metade e o brilho que gira
           passa a ser o que se vê. */
        #8a6c2e80 0deg,
        var(--gold) 28deg,
        var(--gold-flare) 52deg,
        var(--gold) 76deg,
        #8a6c2e80 108deg,
        #8a6c2e80 360deg
      ) border-box;
    box-shadow: 0 30px 70px -30px #000000f0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tk--gold { animation: tk-giro 5s linear infinite; }
  }
  @keyframes tk-giro {
    to { --tk-angle: 360deg; }
  }

  /* A arte já traz sombra e recorte próprios: entra solta, sem moldura. */
  .tk__art { line-height: 0; margin-bottom: 0.5rem; }
  .tk__art :global(img) { width: 100%; height: auto; }

  .tk__flags {
    display: block;
    height: 2rem;
    width: auto;
    margin: 1.1rem auto 0;
    opacity: 0.9;
  }

  .tk__flag {
    position: absolute;
    top: -0.85rem;
    left: clamp(1.6rem, 3vw, 2.2rem);
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    background-image: linear-gradient(90deg, var(--gold) 0%, var(--gold-flare) 100%);
    color: var(--navy);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* O valor é o que decide a leitura do cartão: cresce acima de tudo. */
  .tk__price {
    margin-top: 1.5rem;
    font-size: clamp(3.4rem, 7.4vw, 4.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.055em;
    color: var(--paper);
    text-align: center;
  }
  .tk__cur { margin-right: 0.3rem; font-size: 0.34em; font-weight: 600; color: var(--gold-lift); vertical-align: 0.72em; }
  /* Centavos menores: pesam na leitura sem disputar com o número cheio. */
  .tk__cents { font-size: 0.42em; letter-spacing: -0.02em; vertical-align: 0.62em; }
  /* Etiqueta, não linha de texto: a escassez precisa ler como selo. */
  .tk__vagas {
    display: flex;
    width: fit-content;
    align-items: center;
    margin: 0.8rem auto 0;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--gold);
    border-radius: 100px;
    background: #d7b3561f;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-lift);
  }

  .tk .cta { display: flex; margin: 1.3rem auto 0; }
  /* Royal: o botão veste o azul da arte do próprio ingresso, com o realce
     claro que aparece no lettering "Royal". */
  .cta--royal {
    background-color: #16306f;
    background-image: linear-gradient(90deg, #16306f 0%, #2f5bb5 100%);
    border: 1px solid #609fff59;
    color: #eaf1ff;
    /* O halo dourado do botão padrão não cabe num botão azul. */
    box-shadow:
      0 calc(10px + var(--raise) * 8px) calc(30px + var(--raise) * 20px) #2f5bb540,
      0 6px 18px #0000005c;
  }
  .cta--royal:hover {
    background-image: linear-gradient(90deg, #1b3a86 0%, #3a6bd0 100%);
    border-color: #8eb7ff80;
  }

  .tk__btns { display: grid; gap: 0.5rem; margin-top: 0.75rem; }
  .tk__btn2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--edge-lit);
    border-radius: 8px;
    color: var(--paper);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .tk__btn2 span { font-weight: 700; color: var(--gold-lift); }
  .tk__btn2:hover { border-color: var(--gold); background: #d7b3560d; }

  /* Fecha o bloco dos pacotes: fica logo abaixo da opção de 5+ ingressos. */
  .tk__note {
    max-width: 34ch;
    margin: 0.8rem auto 0;
    font-size: 0.82rem;
    color: var(--paper);
    text-align: center;
    text-wrap: balance;
  }

  /* O que está incluso vem antes do preço: o valor é lido depois da entrega. */
  .tk__incl {
    margin-top: 1.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--edge-lit);
  }
  .tk__inclh {
    margin-bottom: 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-flare);
  }
  .tk__inclh { text-align: center; }
  .tk__incl ul { display: grid; gap: 0.7rem; }
  /* Centralizado, com o ícone colado no texto: o par anda junto no eixo,
     em vez de o traço ficar preso numa coluna à esquerda. */
  .tk__incl li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.94rem;
    color: var(--paper);
    text-align: center;
  }
  .tk__incl :global(svg) { color: var(--gold); flex: none; }

  .g-center { width: 42rem; height: 26rem; top: 10%; left: 50%; transform: translateX(-50%); opacity: 0.3; }
</style>
