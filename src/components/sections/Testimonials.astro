---
import { Image } from 'astro:assets';
import placaBiancaElaine from '../../assets/placa-bianca-elaine.jpg';
import placaIzaac from '../../assets/placa-izaac.jpg';
import print1 from '../../assets/print-depoimento-1.jpg';
import print2 from '../../assets/print-depoimento-2.jpg';

const placas = [
  {
    img: placaBiancaElaine,
    alt: 'Bianca e Elaine com a placa de R$ 1 milhão',
    num: 'R$ 1 milhão',
    nome: 'Bianca e Elaine',
    texto: 'Faturado. Se conheceram no ambiente dos Visionários e viraram sócias.',
  },
  {
    img: placaIzaac,
    alt: 'Izaac com a placa de R$ 400 mil',
    num: 'R$ 400 mil',
    nome: 'Izaac, Conex Contabilidade',
    texto: 'Faturados, com uma implementação em cima da outra.',
  },
];

const prints = [
  { img: print1, alt: 'Depoimento: saímos com um plano de execução e começamos a colocar em prática na mesma semana' },
  { img: print2, alt: 'Depoimento: reestruturei a equipe, entraram 6 clientes novos, foi o melhor evento de que já participei' },
];
---

<!-- ══ Depoimentos ══ -->
<section class="dep" id="depoimentos" aria-labelledby="t-dep">
  <div class="shell">
    <h2 id="t-dep" class="rise">Quem aplicou o método, <span class="hand">cresceu.</span></h2>

    <div class="plq stagger">
      {placas.map((p) => (
        <div class="pc">
          <div class="ph">
            <Image src={p.img} alt={p.alt} widths={[560, 1120]} sizes="(max-width: 51rem) 92vw, 34rem" quality={88} />
          </div>
          <div class="cp">
            <div class="num">{p.num}</div>
            <div>
              <h3>{p.nome}</h3>
              <p>{p.texto}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="prt-h rise">
      <h3>De quem já esteve em um evento presencial nosso</h3>
    </div>

    {/* `rise` e não `stagger`: a cascata anima o transform de cada filho, e os
        prints já usam o deles para ficarem tortos. Os dois brigando, o papel
        chegava torto e se endireitava sozinho. Aqui o grupo sobe inteiro. */}
    <div class="prt rise">
      {prints.map((p) => (
        <div class="pr">
          {/* Qualidade acima do padrão: é print de conversa, e o que vale aqui
              é conseguir ler o que a pessoa escreveu. */}
          <Image src={p.img} alt={p.alt} widths={[460, 920]} sizes="(max-width: 51rem) 92vw, 28rem" quality={92} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .dep {
    --plq-face: #0a2a5c;
    --plq-line: #1b3d78;
    background:
      radial-gradient(900px 500px at 50% 0%, #d7b35612, transparent 70%),
      var(--ground);
  }

  .dep h2 {
    max-width: 54rem;
    margin-inline: auto;
    font-size: clamp(1.9rem, 4.2vw, 3.25rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-align: center;
    text-wrap: balance;
  }

  .plq {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    margin-top: clamp(3rem, 6vw, 4.4rem);
  }
  .pc {
    border: 1px solid var(--plq-line);
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--plq-face), #072049);
    box-shadow: 0 40px 80px -40px #000000b3;
  }
  .pc .ph { aspect-ratio: 16 / 10; overflow: hidden; }
  .pc .ph :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .pc:hover .ph :global(img) { transform: scale(1.04); }
  .pc .cp { display: flex; gap: 1.4rem; align-items: center; padding: 1.5rem 1.6rem 1.75rem; }
  /* O número é o argumento: recortado no gradiente dourado, separado do nome
     por um filete, para ler como placa e não como legenda. */
  .pc .num {
    flex: 0 0 auto;
    padding-right: 1.4rem;
    border-right: 1px solid var(--plq-line);
    font-size: clamp(1.75rem, 3vw, 2.38rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(90deg, var(--gold), var(--gold-flare));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .pc h3 { font-size: 1.19rem; font-weight: 700; line-height: 1.25; }
  .pc p { margin-top: 0.25rem; font-size: 0.94rem; line-height: 1.5; color: var(--paper); }

  .prt-h { text-align: center; margin-top: clamp(3.5rem, 7vw, 6.25rem); }
  .prt-h h3 { font-size: clamp(1.5rem, 2.8vw, 2.13rem); font-weight: 700; letter-spacing: -0.02em; }

  .prt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.1rem;
    align-items: start;
    max-width: 58.75rem;
    margin: 2.75rem auto 0;
  }
  /* Os prints entram tortos, como papel largado na mesa, e se endireitam no
     hover. O deslocamento do segundo evita que os dois leiam como um par
     simétrico, que é o que faria parecer montagem. */
  .pr {
    padding: 0.875rem;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 40px 80px -30px #000000bf, 0 0 0 6px #ffffff0a;
    transition: transform 0.35s var(--ease);
  }
  .pr:nth-child(1) { transform: rotate(-1.2deg); }
  .pr:nth-child(2) { transform: rotate(1.2deg) translateY(34px); }
  .pr:hover { transform: rotate(0) translateY(0); }
  .pr :global(img) { width: 100%; height: auto; border-radius: 12px; }

  @media (max-width: 51rem) {
    .plq, .prt { grid-template-columns: 1fr; }
    .plq { gap: 1.25rem; }
    .pr:nth-child(1), .pr:nth-child(2) { transform: none; }
    .pc .cp { padding: 1.25rem; gap: 1rem; }
    .pc .num { padding-right: 1rem; }
  }
</style>
