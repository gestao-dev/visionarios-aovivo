---
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import heroSala from '../../assets/hero-sala.png';
import heroSalaMobile from '../../assets/hero-sala-mobile.png';

// Abertura da página, reaproveitada entre captação e vendas: mesma foto,
// mesmo tratamento, só o texto e a ação mudam por página.
const {
  badge = 'Visionários ao vivo 2026',
  ctaLabel,
  ctaHref,
  facts = [
    { icon: 'calendar', text: '29 e 30 de Outubro de 2026' },
    { icon: 'pin', text: 'São Paulo' },
    { icon: 'hourglass', text: '2 dias presenciais' },
  ],
} = Astro.props;

// Direção de arte na abertura: o celular recebe um enquadramento próprio, e o
// <picture> garante que só um dos dois seja baixado.
const heroLargo = await getImage({ src: heroSala, widths: [720, 1200, 1920], format: 'webp', quality: 82 });
const heroEstreito = await getImage({ src: heroSalaMobile, widths: [430, 760, 1043], format: 'webp', quality: 86 });
---

<section class="hero" id="topo">
  <div class="hero__plate">
    <picture>
      <source media="(max-width: 46rem)" type="image/webp"
              srcset={heroEstreito.srcSet.attribute} sizes="100vw" />
      <img src={heroLargo.src} srcset={heroLargo.srcSet.attribute} sizes="100vw"
           width={1920} height={1027} loading="eager" fetchpriority="high" decoding="async"
           alt="Visionários ao Vivo, edição anterior, sala lotada de participantes" />
    </picture>
    <div class="hero__wash"></div>
  </div>
  <span class="glow glow--gold hero__g1" aria-hidden="true"></span>
  <span class="glow glow--navy hero__g2" aria-hidden="true"></span>

  <div class="shell hero__in stagger">
    <span class="badge">
      <!-- Ponto vivo do arquivo do cliente: halo translúcido e miolo cheio. -->
      <svg class="badge__mark" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" focusable="false">
        <circle cx="7.5" cy="7.5" r="7.5" fill="#FF0000" fill-opacity="0.5" />
        <circle cx="7.5" cy="7.5" r="5.19231" fill="#FF2828" />
      </svg>
      {badge}
    </span>

    <h1><slot name="title" /></h1>

    <p class="hero__sub"><slot name="sub" /></p>

    {ctaHref ? (
      <a class="cta" href={ctaHref}>{ctaLabel}</a>
    ) : (
      <button class="cta" type="button" data-open-lead>{ctaLabel}</button>
    )}

    <ul class="facts">
      {facts.map((f) => <li><Icon name={f.icon} size={15} /> {f.text}</li>)}
    </ul>
  </div>
</section>

<style>
  /* ── Abertura: reconstruída a partir do arquivo do cliente ── */
  /* O conteúdo mora no rodapé da dobra: a altura é a da tela menos o header,
     e o bloco encosta embaixo. Assim ele fica lá no pé como na referência
     sem que a ação caia abaixo da dobra em tela baixa. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: calc(100svh - 95px);
    padding-block: clamp(6rem, 14vh, 10rem) clamp(3.5rem, 7vw, 6rem);
    isolation: isolate;
    overflow: clip;
    text-align: center;
  }
  @media (max-width: 44rem) { .hero { min-height: calc(100svh - 76px); } }
  /* No celular a foto não cobre a dobra: vira faixa no topo, na proporção
     dela, e o véu a dissolve no preto antes do selo. */
  @media (max-width: 46rem) {
    .hero__plate { bottom: auto; height: auto; aspect-ratio: 1920 / 1027; }
    .hero__wash {
      background: linear-gradient(180deg, #041e4214 0%, #041e426b 46%, var(--ground) 100%);
    }
  }
  .hero__plate { position: absolute; inset: 0; z-index: -2; isolation: isolate; }
  /* Ancorada embaixo: é onde a plateia está, e é o que não pode ser cortado. */
  .hero__plate :global(img) {
    position: relative; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center bottom;
    filter: saturate(0.9) contrast(1.02) brightness(0.86);
  }
  /* Escurecimento vertical até o preto, como no arquivo. */
  .hero__wash {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, #041e4208 0%, #041e4259 46%, var(--ground) 90%),
      radial-gradient(78% 52% at 50% 46%, #041e425c 0%, #041e42b3 100%);
  }
  .hero__g1 { width: 46rem; height: 28rem; top: 16%; left: 50%; transform: translateX(-50%); opacity: 0.22; }
  .hero__g2 { display: none; }

  .hero__in { position: relative; z-index: 2; }

  .badge__mark { flex: none; color: var(--gold-flare); }

  h1 {
    margin-top: 12px;
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(3rem, 5.6vw, 5.125rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--paper);
    text-shadow: 0 2px 50px #000000a6;
  }
  h1 :global(.hand) {
    font-size: 1.07em;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .hero__sub {
    max-width: 45rem;
    margin: 12px auto 0;
    font-size: clamp(1.02rem, 2.1vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--paper);
  }
  .hero__sub :global(b) { font-weight: 700; color: var(--gold-flare); }

  .hero .cta {
    margin-top: 20px;
    min-width: min(100%, 26rem);
    padding: 1.35rem 3.75rem;
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
  }

  .facts {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin-top: 12px;
    font-size: 0.82rem;
    color: #f0f0f0;
  }
  .facts li { display: inline-flex; align-items: center; gap: 5px; }
  .facts :global(svg) { color: var(--gold); flex: none; }
</style>
