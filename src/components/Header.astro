---
// Cabeçalho fixo em vidro. O regressivo mora aqui — acompanha a rolagem
// inteira em vez de ficar preso a um bloco da hero.
---

<header class="bar">
  <div class="shell bar__in">
    <a class="mark" href="#topo" aria-label="Visionários ao Vivo 2026 — início">
      <!-- PLACEHOLDER: troque por /logo.svg quando enviar o arquivo da marca. -->
      <span class="mark__ring" aria-hidden="true"></span>
      <span class="mark__txt">Contadores<br /><b>Visionários</b></span>
    </a>

    <div class="clock" role="timer" aria-live="off">
      <span class="clock__tag">O evento começa em</span>
      <dl>
        <div><dd data-u="d">—</dd><dt>d</dt></div>
        <div><dd data-u="h">—</dd><dt>h</dt></div>
        <div><dd data-u="m">—</dd><dt>m</dt></div>
        <div><dd data-u="s">—</dd><dt>s</dt></div>
      </dl>
    </div>

    <button class="cta bar__cta" type="button" data-open-lead>Entrar na lista</button>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: #04050ce0;
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 1px 0 #ffffff0f, 0 10px 30px -20px #000;
  }
  .bar__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .mark { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .mark__ring {
    width: 2.1rem; height: 2.1rem; flex: none;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, transparent 34%, var(--gold) 35% 52%, transparent 53%),
      radial-gradient(circle at 50% 50%, var(--gold-lift) 0 18%, transparent 19%);
  }
  .mark__txt {
    font-size: 0.7rem;
    line-height: 1.25;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--paper-dim);
  }
  .mark__txt b { color: var(--paper); font-weight: 600; }

  /* Cápsula de vidro do regressivo */
  .clock {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 1.05rem;
    border: 1px solid #ffffff1f;
    border-radius: 999px;
    background: linear-gradient(180deg, #ffffff1a, #00030f66);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 #ffffff2b;
  }
  .clock__tag {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }
  .clock dl { display: flex; gap: 0.55rem; margin: 0; }
  .clock div { display: flex; align-items: baseline; gap: 0.1rem; }
  .clock dd {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--gold-lift);
  }
  .clock dt { font-size: 0.74rem; color: var(--paper); }

  .bar__cta { padding: 0.72rem 1.5rem; font-size: 0.9rem; }

  @media (max-width: 60rem) {
    .bar__cta { display: none; }
    .clock__tag { display: none; }
  }
  @media (max-width: 26rem) {
    .mark__txt { display: none; }
  }
</style>

<script>
  // 29/10/2026, 09:00 no horário de Brasília.
  const alvo = new Date('2026-10-29T09:00:00-03:00').getTime();
  const campo = (u: string) => document.querySelector<HTMLElement>(`.clock [data-u="${u}"]`);
  const els = { d: campo('d'), h: campo('h'), m: campo('m'), s: campo('s') };

  function tick() {
    const resto = alvo - Date.now();
    const seg = Math.max(0, Math.floor(resto / 1000));
    const pad = (n: number) => String(n).padStart(2, '0');
    if (els.d) els.d.textContent = String(Math.floor(seg / 86400));
    if (els.h) els.h.textContent = pad(Math.floor(seg / 3600) % 24);
    if (els.m) els.m.textContent = pad(Math.floor(seg / 60) % 60);
    if (els.s) els.s.textContent = pad(seg % 60);
  }
  tick();
  setInterval(tick, 1000);
</script>
