---
// Barra de topo conforme o arquivo do cliente (nó 2720:869):
// 95px, fundo preto a 58%, desfoque leve, filete dourado embaixo.
---

<header class="bar">
  <div class="bar__in">
    <a class="mark" href="#topo" aria-label="Visionários ao Vivo — início">
      <img class="mark__img" src="/logo-visionarios-ao-vivo.svg"
           alt="Visionários ao Vivo" width="196" height="48" />
    </a>

    <div class="count" role="timer" aria-live="off">
      <span class="count__tag">O evento começa em:</span>
      <div class="count__boxes">
        <div class="box"><b data-u="d">00</b><span>DIAS</span></div>
        <div class="box"><b data-u="h">00</b><span>HORAS</span></div>
        <div class="box"><b data-u="m">00</b><span>MIN</span></div>
        <div class="box"><b data-u="s">00</b><span>SEG</span></div>
      </div>
    </div>

    <button class="cta bar__cta" type="button" data-open-lead>Garantir meu ingresso</button>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 60;
    height: 95px;
    background: #05060f8c;
    backdrop-filter: blur(22px) saturate(1.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.35);
    border-bottom: 1px solid var(--edge-lit);
  }
  /* Três colunas iguais nas pontas: o regressivo fica no centro óptico da tela,
     não no centro do espaço que sobra. */
  .bar__in {
    height: 100%;
    width: min(100% - 2.5rem, 88rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }
  .count { justify-self: center; }
  .bar__cta { justify-self: end; }

  /* ── Marca ── */
  .mark { display: inline-flex; text-decoration: none; }
  /* Medida exata do arquivo do cliente. */
  .mark__img { width: 196px; height: 48px; }

  /* ── Regressivo ── */
  .count { display: flex; align-items: center; gap: 12px; }
  .count__tag {
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }
  .count__boxes { display: flex; gap: 5px; }
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    width: 60px;
    height: 54px;
    border: 1px solid var(--edge-lit);
    border-radius: 4px;
    background: #5a3e361a;
    color: #fff;
  }
  .box b {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .box span { font-size: 9px; font-weight: 400; line-height: 1.2; color: #ffffffb3; }

  .bar__cta {
    padding: 0.9rem 1.7rem;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  @media (max-width: 78rem) {
    .count__tag { display: none; }
  }
  @media (max-width: 60rem) {
    .bar__in { grid-template-columns: auto 1fr; }
    .bar__cta { display: none; }
    .count { justify-self: end; }
  }
  @media (max-width: 44rem) {
    .bar { height: 76px; }
    .box { width: 46px; height: 44px; gap: 1px; }
    .box b { font-size: 1.12rem; }
    .mark__img { width: 150px; height: 37px; }
  }
</style>

<script>
  // 29/10/2026, 09:00 no horário de Brasília.
  const alvo = new Date('2026-10-29T09:00:00-03:00').getTime();
  const el = (u: string) => document.querySelector<HTMLElement>(`.box [data-u="${u}"]`);
  const campos = { d: el('d'), h: el('h'), m: el('m'), s: el('s') };

  function tick() {
    const seg = Math.max(0, Math.floor((alvo - Date.now()) / 1000));
    const pad = (n: number) => String(n).padStart(2, '0');
    if (campos.d) campos.d.textContent = pad(Math.floor(seg / 86400));
    if (campos.h) campos.h.textContent = pad(Math.floor(seg / 3600) % 24);
    if (campos.m) campos.m.textContent = pad(Math.floor(seg / 60) % 60);
    if (campos.s) campos.s.textContent = pad(seg % 60);
  }
  tick();
  setInterval(tick, 1000);
</script>
