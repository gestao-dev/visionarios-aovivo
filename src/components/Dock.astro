---
// Barra de ação fixa no rodapé, só no celular. Aparece na metade da segunda
// dobra e, quando aparece, o cabeçalho sobe: a ação fica onde o polegar
// alcança, e a marca não ocupa duas barras ao mesmo tempo.
// A ação é parametrizável do mesmo jeito que no Header.
const { ctaLabel = 'Entrar na lista', ctaHref } = Astro.props;
---

<div class="dock">
  <div class="dock__in">
    <img class="dock__mark" src="/logo-visionarios-ao-vivo.svg"
         alt="Visionários ao Vivo" width="196" height="48" />
    {ctaHref ? (
      <a class="cta dock__cta" href={ctaHref}>{ctaLabel}</a>
    ) : (
      <button class="cta dock__cta" type="button" data-open-lead>{ctaLabel}</button>
    )}
  </div>
</div>

<style>
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 70;
    display: none;
    background: #041e42d9;
    backdrop-filter: blur(22px) saturate(1.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.35);
    border-top: 1px solid var(--edge-lit);
    /* Fora da tela e sem foco enquanto não entra. A saída desce por inteiro,
       com a opacidade indo junto: só o transform deixava a barra visível
       cruzando a borda da tela em aparelho baixo. */
    transform: translateY(120%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.62s cubic-bezier(0.36, 0, 0.2, 1),
      opacity 0.42s var(--ease),
      visibility 0s linear 0.62s;
  }
  .dock__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 20px;
    /* Respeita a barra de gestos do aparelho. */
    padding-bottom: max(0.7rem, env(safe-area-inset-bottom));
  }
  .dock__mark { width: 124px; height: 30px; flex: none; }
  .dock__cta {
    padding: 0.8rem 1.1rem;
    font-size: 0.82rem;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  @media (max-width: 60rem) {
    .dock { display: block; }
  }
  /* Entrada com a curva de saída-suave: sobe rápido e assenta devagar. */
  :global(html.dock-on) .dock {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.34s var(--ease),
      visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .dock { transition: none; }
  }
</style>

<script>
  const marco = document.getElementById('dobra-2');
  // Onde a própria página passa a oferecer a ação: a partir daí a barra
  // fixa vira redundante e sai de cena.
  const fim = document.getElementById('garanta');
  const raiz = document.documentElement;

  if (marco) {
    // Aparece quando metade da segunda dobra já passou pelo topo da tela, e
    // recolhe assim que "Garanta sua vaga" sobe além do topo.
    function avaliar() {
      const r = marco.getBoundingClientRect();
      const entrou = r.top + r.height * 0.5 <= 0;
      const saiu = fim ? fim.getBoundingClientRect().top <= 0 : false;
      raiz.classList.toggle('dock-on', entrou && !saiu);
    }

    let pendente = false;
    function agendar() {
      if (pendente) return;
      pendente = true;
      requestAnimationFrame(() => {
        pendente = false;
        avaliar();
      });
    }

    avaliar();
    addEventListener('scroll', agendar, { passive: true });
    addEventListener('resize', agendar, { passive: true });
  }
</script>
