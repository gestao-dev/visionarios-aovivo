---
import '../styles/global.css';

const {
  title = 'Visionários ao Vivo 2026 — Lista do Lote Zero',
  description = '2 dias presenciais para o dono de escritório contábil reinventar o negócio. Entre na lista do Lote Zero.',
} = Astro.props;

// Vem do `site` em astro.config.mjs: uma linha só define o domínio em todo
// lugar. Enquanto a página roda num domínio de teste, o canônico apontando
// pro definitivo é o que impede o teste de ser indexado no lugar dele.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#01020c" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="100x100" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />

    <link rel="preload" href="/fonts/manrope-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- IvyPresto Display (Adobe Fonts). <link> em vez de @import: @import serializa
         o download e adia o first paint, custo que uma página de lançamento não paga. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/dbc3pfu.css" />

    <script is:inline>
      // Liga o estado inicial das entradas antes da primeira pintura, senão o
      // conteúdo pisca visível e some. A rede de segurança embaixo desliga tudo
      // se o observador não confirmar que assumiu: melhor sem animação do que
      // com a página escondida.
      (function () {
        var raiz = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        raiz.classList.add('reveal-on');
        setTimeout(function () {
          if (!raiz.dataset.revealPronto) raiz.classList.remove('reveal-on');
        }, 2500);
      })();
    </script>
  </head>

  <body>
    <!--
    THESIS: Uma sala cheia de contadores decidindo mudar de lado, vendida como
    acontecimento e não como formulário de inscrição. Recusa o arranjo raso da
    página anterior: texto sobre fundo chapado, filete no lugar de matéria.
    OWN-WORLD: Quase preto azulado com halos de luz difusa; painéis com borda de
    luz interna e sombra profunda em vez de linhas; ouro como metal escovado, só
    em ação e destaque, nunca como fundo; Manrope no corpo e IvyPresto itálica nos
    realces de headline; ícones autorais de traço único.
    STORY: Ele se reconhece no lado errado do muro, vê o outro lado existir com
    nome e rosto, e entra na lista.
    FIRST VIEWPORT: Foto da sala em sangria sob véu e halo; conteúdo centralizado
    — selo ao vivo, imprint, título com uma palavra em itálica dourada, fatos com
    ícone, cápsula dourada e selo de confiança. Regressivo em vidro no cabeçalho
    fixo, visível a rolagem inteira.
    FORM: página de lançamento premium, refeita sobre referências do cliente.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <slot />

    <script>
      const raiz = document.documentElement;
      const alvos = document.querySelectorAll<HTMLElement>('.rise, .fade, .from-l, .from-r, .zoom, .stagger');

      if (raiz.classList.contains('reveal-on') && alvos.length) {
        raiz.dataset.revealPronto = '1';
        const restantes = new Set<HTMLElement>(Array.from(alvos));

        // Teste de posição, não de evento: quem já passou do gatilho entra,
        // mesmo que a rolagem tenha sido um salto. Um observador de interseção
        // pode não amostrar o quadro em que o elemento cruzou a tela, e aí ele
        // ficaria escondido pra sempre.
        function passar() {
          // No fim da página não sobra rolagem pra cruzar o gatilho: o que
          // ainda estiver na última faixa da tela entra de uma vez.
          const noFim =
            window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
          // Gatilho no pé da tela, não antes dele: com 0.9 sobrava uma faixa
          // morta de 10% onde o que parasse ali nunca era revelado, que era o
          // caso do rodapé e do fecho quando a página acaba.
          const gatilho = window.innerHeight;
          for (const el of Array.from(restantes)) {
            if (noFim || el.getBoundingClientRect().top < gatilho) {
              el.classList.add('is-in');
              restantes.delete(el);
            }
          }
          if (restantes.size === 0) {
            removeEventListener('scroll', agendar);
            removeEventListener('resize', agendar);
            observadorLayout?.disconnect();
          }
        }

        let pendente = false;
        function agendar() {
          if (pendente) return;
          pendente = true;
          requestAnimationFrame(() => {
            pendente = false;
            passar();
          });
        }

        // A página cresce enquanto as imagens chegam. Sem isto, quem estava
        // fora do gatilho quando a altura era menor nunca é reavaliado.
        const observadorLayout =
          'ResizeObserver' in window ? new ResizeObserver(agendar) : null;
        observadorLayout?.observe(document.body);

        passar();
        addEventListener('scroll', agendar, { passive: true });
        addEventListener('resize', agendar, { passive: true });
        addEventListener('load', agendar);
      } else {
        raiz.classList.remove('reveal-on');
      }
    </script>
  </body>
</html>
