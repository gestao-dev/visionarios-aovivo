---
import '../styles/global.css';

const {
  title = 'Visionários ao Vivo 2026 — Lista do Lote Zero',
  description = '2 dias presenciais para o dono de escritório contábil reinventar o negócio. Entre na lista do Lote Zero.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#01020c" />
    <link rel="canonical" href="https://www.visionariosaovivo.com.br/" />

    <link rel="preload" href="/fonts/manrope-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- IvyPresto Display (Adobe Fonts). <link> em vez de @import: @import serializa
         o download e adia o first paint, custo que uma página de lançamento não paga. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/dbc3pfu.css" />

    <script is:inline>
      // Liga o estado inicial das entradas antes da primeira pintura, senão o
      // conteúdo pisca visível e some. A rede de segurança embaixo desliga tudo
      // se o observador não confirmar que assumiu: melhor sem animação do que
      // com a página escondida.
      (function () {
        var raiz = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        raiz.classList.add('reveal-on');
        setTimeout(function () {
          if (!raiz.dataset.revealPronto) raiz.classList.remove('reveal-on');
        }, 2500);
      })();
    </script>
  </head>

  <body>
    <!--
    THESIS: Uma sala cheia de contadores decidindo mudar de lado, vendida como
    acontecimento e não como formulário de inscrição. Recusa o arranjo raso da
    página anterior: texto sobre fundo chapado, filete no lugar de matéria.
    OWN-WORLD: Quase preto azulado com halos de luz difusa; painéis com borda de
    luz interna e sombra profunda em vez de linhas; ouro como metal escovado, só
    em ação e destaque, nunca como fundo; Manrope no corpo e IvyPresto itálica nos
    realces de headline; ícones autorais de traço único.
    STORY: Ele se reconhece no lado errado do muro, vê o outro lado existir com
    nome e rosto, e entra na lista.
    FIRST VIEWPORT: Foto da sala em sangria sob véu e halo; conteúdo centralizado
    — selo ao vivo, imprint, título com uma palavra em itálica dourada, fatos com
    ícone, cápsula dourada e selo de confiança. Regressivo em vidro no cabeçalho
    fixo, visível a rolagem inteira.
    FORM: página de lançamento premium, refeita sobre referências do cliente.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <slot />

    <script>
      const raiz = document.documentElement;
      const alvos = document.querySelectorAll<HTMLElement>('.rise, .fade, .from-l, .from-r, .zoom, .stagger');

      if (raiz.classList.contains('reveal-on') && 'IntersectionObserver' in window && alvos.length) {
        raiz.dataset.revealPronto = '1';
        const olho = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              olho.unobserve(e.target);
            }
          },
          // Dispara um pouco antes de encostar no pé da tela, pra o elemento
          // chegar já em movimento em vez de aparecer parado e depois animar.
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        alvos.forEach((el) => olho.observe(el));
      } else {
        raiz.classList.remove('reveal-on');
      }
    </script>
  </body>
</html>
