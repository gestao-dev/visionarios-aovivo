---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Bands from '../components/Bands.astro';
import Dock from '../components/Dock.astro';
import Hero from '../components/sections/Hero.astro';
import Wall from '../components/sections/Wall.astro';
import Method from '../components/sections/Method.astro';
import Speakers from '../components/sections/Speakers.astro';
import Qualify from '../components/sections/Qualify.astro';
import Tickets from '../components/sections/Tickets.astro';
import Faq from '../components/sections/Faq.astro';
import Close from '../components/sections/Close.astro';

const title = 'Visionários ao Vivo 2026 — Ingressos Lote Zero';
const description =
  '2 dias presenciais para o dono de escritório contábil reinventar o negócio. Garanta seu ingresso no Lote Zero, o menor preço do evento.';
---

<Base title={title} description={description}>
  <Header ctaLabel="Garantir meu ingresso" ctaHref="#ingressos" />

  <Hero ctaLabel="Garantir meu ingresso" ctaHref="#ingressos">
    <Fragment slot="title">Sua nova visão da contabilidade <span class="hand">começa agora.</span></Fragment>
    <Fragment slot="sub">
      Dois dias de implementação mão na massa para o dono de escritório contábil
      reinventar o próprio negócio e <b>resolver 6 meses de estruturação em 2 dias.</b>
    </Fragment>
  </Hero>

  <Bands />

  <div class="tail">
    <Wall />
    <Method />
    <Speakers />
    <Qualify />
    <Tickets />
    <Faq />

    <Close
      eyebrow="Última chamada"
      ctaLabel="Garantir meu ingresso"
      ctaHref="#ingressos"
    >
      <Fragment slot="title">
        O <span class="hand">Lote Zero</span> é o menor preço<br class="turn" />
        que esse evento vai ter.
      </Fragment>
      <Fragment slot="lede">
        Quando essas vagas acabarem, o valor sobe e não volta.<br />
        Garanta o seu agora, pelo preço de quem chegou primeiro.
      </Fragment>
    </Close>

    <footer class="foot">
      <div class="shell fade">Visionários ao Vivo 2026 · Contadores Visionários</div>
    </footer>
  </div>

  <Dock ctaLabel="Garantir ingresso" ctaHref="#ingressos" />
</Base>

<style>
  /* A hero termina em preto; a dobra seguinte nasce nesse mesmo preto e só
     então caminha para o azul da página. */
  .tail { background: var(--ground); }

  .turn { display: none; }
  @media (min-width: 44rem) { .turn { display: inline; } }

  .foot {
    padding-block: 2.4rem;
    color: var(--paper); font-size: 0.82rem; text-align: center;
    box-shadow: inset 0 1px 0 #ffffff0d;
  }
</style>
