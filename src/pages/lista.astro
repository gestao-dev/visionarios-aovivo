---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import LeadModal from '../components/LeadModal.astro';
import Bands from '../components/Bands.astro';
import Dock from '../components/Dock.astro';
import Hero from '../components/sections/Hero.astro';
import Wall from '../components/sections/Wall.astro';
import Method from '../components/sections/Method.astro';
import Speakers from '../components/sections/Speakers.astro';
import Qualify from '../components/sections/Qualify.astro';
import LoteZero from '../components/sections/LoteZero.astro';
import Close from '../components/sections/Close.astro';
---

<Base>
  <Header />

  <Hero ctaLabel="Entrar na lista do Lote Zero">
    <Fragment slot="title">Sua nova visão da contabilidade <span class="hand">começa agora.</span></Fragment>
    <Fragment slot="sub">
      Dois dias de implementação mão na massa para o dono de escritório contábil
      reinventar o próprio negócio e <b>resolver 6 meses de estruturação em 2 dias.</b>
    </Fragment>
  </Hero>

  <Bands />

  <div class="tail">
    <Wall />
    <Method />
    <Speakers />
    <Qualify />
    <LoteZero />

    <Close ctaLabel="Entrar na lista do Lote Zero" titleNowrap>
      <Fragment slot="title">
        Você pode entrar em 2027 igual.<br />
        <span class="hand">Ou atravessar o muro agora.</span>
      </Fragment>
      <Fragment slot="lede">
        Entre na lista do Lote Zero e seja o primeiro a garantir sua vaga na 1ª edição<br class="turn" />
        do Visionários ao Vivo, pelo menor preço, com bônus exclusivo.
      </Fragment>
    </Close>

    <footer class="foot">
      <div class="shell fade">Visionários ao Vivo 2026 · Contadores Visionários</div>
    </footer>
  </div>

  <Dock />
  <LeadModal />
</Base>

<style>
  /* A hero termina em preto; a dobra seguinte nasce nesse mesmo preto e só
     então caminha para o azul da página. Sem isso fica a emenda visível.
     A arte da abertura termina na própria cor da página, então aqui não há
     transição a fazer. */
  .tail { background: var(--ground); }

  .turn { display: none; }
  @media (min-width: 44rem) { .turn { display: inline; } }

  .foot {
    padding-block: 2.4rem;
    color: var(--paper); font-size: 0.82rem; text-align: center;
    box-shadow: inset 0 1px 0 #ffffff0d;
  }
</style>
