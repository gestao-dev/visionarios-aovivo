---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import LeadModal from '../components/LeadModal.astro';
import Bands from '../components/Bands.astro';
import Mono from '../components/Mono.astro';
import sala from '../assets/sala.jpg';
import viviane from '../assets/viviane.jpg';
import marcos from '../assets/marcos.png';

const daqui = [
  'Faturamento travado no teto',
  'Cliente que entra e sai',
  'Equipe que não anda sem você',
  'Você fazendo tudo, o dia todo',
];
const dela = [
  'Escritório lucrativo e previsível',
  'Cliente que fica e indica',
  'Time que roda sem você',
  'Você no estratégico, com liberdade',
];
const fases = [
  { icon: 'mind',  nome: 'Mentalidade & Modelo' },
  { icon: 'users', nome: 'Equipe & Estrutura' },
  { icon: 'cpu',   nome: 'Sistemas, Tech & IA' },
  { icon: 'chart', nome: 'Receita & Faturamento' },
];
const sprint = [
  { quando: 'Evento',    oque: '29–30/out' },
  { quando: 'Novembro',  oque: 'implementa' },
  { quando: 'Dezembro',  oque: 'consolida' },
  { quando: '2027',      oque: 'estruturado' },
];
const criterios = [
  'Você é dono de escritório contábil (não estudante, não iniciante)',
  'A empresa não anda sem você, e isso já te esgotou',
  'Você tem técnica de sobra, mas gestão de menos',
  'Você prefere implementar a acumular mais um curso na estante',
  'Você quer entrar em 2027 com o escritório estruturado, não no mesmo caos',
];
const vantagens = [
  { icon: 'star',      texto: 'O menor preço do evento: abre antes de todos os lotes, por 48h, e não volta.' },
  { icon: 'gift',      texto: 'Bônus físico exclusivo pra quem garantir nas primeiras 48h.' },
  { icon: 'stopwatch', texto: 'Prioridade na abertura: você é avisado primeiro, antes da lista pública.' },
  { icon: 'clapper',   texto: 'Bastidores e lineup: palestrantes e novidades em primeira mão.' },
];
---

<Base>
  <Header />

  <!-- ══ Abertura ══ -->
  <section class="hero" id="topo">
    <div class="hero__plate">
      <Image
        src={sala} alt="Visionários ao Vivo, edição anterior, sala lotada de participantes"
        widths={[720, 1200, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={82}
      />
      <div class="hero__wash"></div>
    </div>
    <span class="glow glow--gold hero__g1" aria-hidden="true"></span>
    <span class="glow glow--navy hero__g2" aria-hidden="true"></span>

    <div class="shell hero__in">
      <span class="badge"><Mono size={15} class="badge__mark" /> Visionários ao vivo 2026</span>

      <h1>Sua nova visão da contabilidade <span class="hand">começa agora.</span></h1>

      <p class="hero__sub">
        Dois dias de implementação mão na massa para o dono de escritório contábil
        reinventar o próprio negócio e <b>resolver 6 meses de estruturação em 2 dias.</b>
      </p>

      <button class="cta" type="button" data-open-lead>Garantir meu ingresso agora.</button>

      <ul class="facts">
        <li><Icon name="calendar" size={15} /> 29 e 30 de Outubro de 2026</li>
        <li><Icon name="pin" size={15} /> São Paulo</li>
        <li><Icon name="hourglass" size={15} /> 2 dias presenciais</li>
      </ul>
    </div>

  </section>

  <Bands />

  <div class="tail">
  <!-- ══ O muro ══ -->
  <section class="eyebrow-free" aria-labelledby="t-muro">
    <span class="glow glow--navy g-left" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Contador comum × Contador visionário</p>
      <h2 id="t-muro">Existe um muro <span class="grad">entre você e o escritório</span> que você queria ter.</h2>
      <p class="sec-lede measure center">
        A diferença entre os dois lados nunca foi técnica: é visão.<br class="turn" />
        O evento é o portal pra atravessar.
      </p>
    </div>

    <div class="shell cross">
      <div class="cross__side">
        <p class="cross__head"><Icon name="wall" size={16} /> <span class="grad">Do lado de cá</span></p>
        <ul>{daqui.map((t) => <li>{t}</li>)}</ul>
      </div>

      <div class="cross__seam" aria-hidden="true">
        <span class="cross__gate"><Icon name="arrow" size={20} /></span>
      </div>

      <div class="cross__side cross__side--to">
        <p class="cross__head cross__head--to"><Icon name="key" size={16} /> <span class="grad">Do outro lado</span></p>
        <ul>{dela.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ══ Método ══ -->
  <section aria-labelledby="t-metodo">
    <span class="glow glow--gold g-right" aria-hidden="true"></span>

    <div class="shell method">
      <div class="method__text">
        <p class="over">Método Aceleração Visionária · exclusivo do evento</p>
        <h2 id="t-metodo">2 dias. 6 meses de estruturação resolvidos.</h2>
        <p class="method__lede">
          4 fases, uma construída sobre a outra, e cada bloco entrega uma ferramenta pronta
          pra aplicar:
        </p>
        <p class="aside">
          <Icon name="star" size={17} /> + Reforma tributária como tema transversal nos dois dias.
        </p>
      </div>

      <!-- As quatro fases como degraus: cada uma se apoia na anterior. -->
      <ol class="steps">
        {fases.map((f, i) => (
          <li style={`--h:${52 + i * 16}%`}>
            <div class="steps__slot">
              <div class="steps__bar">
                <span class="steps__n">{i + 1}</span>
                <Icon name={f.icon} size={26} />
              </div>
            </div>
            <p class="steps__label">{f.nome}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="shell">
      <div class="sprint">
        <h3>
          Você sai com um <span class="hand">Sprint de 60 dias</span><br class="turn" />
          pra chegar em 2027 estruturado
        </h3>
        <ol class="rail">
          {sprint.map((e, i) => (
            <li class={i === sprint.length - 1 ? 'rail--now' : ''}>
              <span class="rail__dot" aria-hidden="true"></span>
              <b>{e.quando}</b>
              <span>{e.oque}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ══ Trailer: placeholder para o vídeo 1:1 ══ -->
  <section class="eyebrow-free" aria-labelledby="t-video">
    <div class="shell center measure-wide">
      <h2 id="t-video">O que acontece na sala</h2>
    </div>
    <div class="shell reel">
      <!-- PLACEHOLDER: suba o trailer 1:1 e troque este bloco por <video poster>. -->
      <div class="reel__box panel rise">
        <span class="reel__play"><Icon name="play" size={30} /></span>
        <p>Trailer do evento · 1:1</p>
        <small>Espaço reservado. Envie o arquivo e eu ligo aqui com poster e clique‑para‑tocar.</small>
      </div>
      <div class="reel__side">
        <!-- PLACEHOLDER: foto vertical da edição anterior (palco, plateia ou bastidor). -->
        <div class="shot panel rise"><span>Foto vertical<br /><small>a enviar</small></span></div>
        <div class="shot panel rise"><span>Foto vertical<br /><small>a enviar</small></span></div>
      </div>
    </div>
  </section>

  <!-- ══ Palestrantes ══ -->
  <section aria-labelledby="t-quem">
    <span class="glow glow--gold g-left" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Quem sobe ao palco</p>
      <h2 id="t-quem" class="grad">Os palestrantes</h2>
      <p class="sec-lede measure center">
        Viviane e Marcos conduzem o método. E, a cada semana, um novo nome de peso do
        mercado contábil é revelado.
      </p>
    </div>

    <ul class="shell cast">
      <li class="cast__card">
        <div class="cast__pic">
          <Image src={viviane} alt="Viviane Araújo" widths={[300, 520]} sizes="(max-width: 62rem) 45vw, 17rem" quality={90} />
        </div>
        <div class="cast__foot">
          <h3>Viviane Araújo</h3>
          <p>Fundadora da Soluzzi · Mentora</p>
        </div>
      </li>

      <li class="cast__card">
        <div class="cast__pic">
          <Image src={marcos} alt="Marcos Paulo" widths={[300, 354]} sizes="(max-width: 62rem) 45vw, 17rem" quality={92} />
        </div>
        <div class="cast__foot">
          <h3>Marcos Paulo</h3>
          <p>Contadores Visionários</p>
        </div>
      </li>

      {[0, 1].map(() => (
        <li class="cast__card">
          <div class="cast__pic cast__pic--tba"><span aria-hidden="true">?</span></div>
          <div class="cast__foot">
            <h3>A revelar</h3>
            <p>Anunciado no grupo</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="shell">
      <p class="aside aside--center">
        <Icon name="clapper" size={17} /> Os convidados são revelados um a um, sempre primeiro
        pra quem está na lista do Lote Zero.
      </p>
    </div>
  </section>

  <!-- ══ Qualificação ══ -->
  <section class="eyebrow-free" aria-labelledby="t-pra">
    <div class="shell center measure-wide">
      <p class="over">Antes de entrar</p>
      <h2 id="t-pra">É pra você se…</h2>
    </div>
    <div class="shell qual">
      <ul class="panel panel--lit rise">
        {criterios.map((c) => (
          <li><span class="tick"><Icon name="check" size={15} /></span><span>{c}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ Lote Zero ══ -->
  <section class="eyebrow-free" aria-labelledby="t-vant">
    <span class="glow glow--gold g-center" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Por que entrar agora</p>
      <h2 id="t-vant">A vantagem de estar na lista</h2>
    </div>

    <div class="shell lote">
      <div class="panel panel--lit rise">
        <div class="lote__head">
          <div>
            <p class="lote__kind">Lote</p>
            <p class="lote__name hand">Zero</p>
          </div>
          <div class="lote__when">
            <span>Abre em</span>
            <strong>22 · 08</strong>
          </div>
        </div>
        <p class="lote__scope">Exclusivo pra quem está no grupo</p>

        <ul class="perks">
          {vantagens.map((v) => (
            <li><span class="medal medal--sm"><Icon name={v.icon} size={19} /></span><span>{v.texto}</span></li>
          ))}
        </ul>

        <div class="lote__act">
          <button class="cta cta--wide" type="button" data-open-lead>
            Quero o Lote Zero + bônus <Icon name="arrow" size={18} />
          </button>
          <p class="assure"><Icon name="shield" size={16} /> Vagas presenciais limitadas · 1ª edição · sala fechada</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Fechamento ══ -->
  <section class="close eyebrow-free" aria-labelledby="t-fim">
    <span class="glow glow--navy g-center" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">A decisão</p>
      <h2 id="t-fim">Você pode entrar em 2027 igual.<br />Ou <span class="hand">atravessar o muro</span> agora.</h2>
      <p class="sec-lede measure center">
        Entre na lista do Lote Zero e seja o primeiro a garantir sua vaga na 1ª edição do
        Visionários ao Vivo, pelo menor preço, com bônus exclusivo.
      </p>
      <button class="cta cta--wide" type="button" data-open-lead>Entrar na lista do Lote Zero</button>
    </div>
  </section>

  <footer class="foot">
    <div class="shell">Visionários ao Vivo 2026 · Contadores Visionários</div>
  </footer>
  </div>

  <LeadModal />
</Base>

<style>
  .measure-wide { max-width: 46rem; }

  /* A hero termina em preto; a dobra seguinte nasce nesse mesmo preto e só
     então caminha para o azul da página. Sem isso fica a emenda visível. */
  .tail {
    background: linear-gradient(180deg, #000001 0, #01020a 14rem, var(--ground) 34rem);
    background-repeat: no-repeat;
  }

  /* Linha curta acima do título: centralizada e destacada como rótulo do bloco,
     não empilhada como rótulo de formulário. */
  .over {
    margin-bottom: 1.1rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-flare);
  }

  /* ── Abertura: reconstruída a partir do arquivo do cliente ── */
  .hero {
    position: relative;
    padding-block: clamp(10rem, 27vh, 18rem) clamp(11rem, 22vw, 19rem);
    isolation: isolate;
    overflow: clip;
    text-align: center;
  }
  .hero__plate { position: absolute; inset: 0; z-index: -2; isolation: isolate; }
  .hero__plate :global(img) {
    position: relative; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 28%;
    filter: saturate(0.9) contrast(1.02) brightness(0.86);
  }
  /* Escurecimento vertical até o preto, como no arquivo. */
  .hero__wash {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, #00000108 0%, #00000159 46%, #000001 87%),
      radial-gradient(78% 52% at 50% 46%, #0000005c 0%, #000001b3 100%);
  }
  .hero__g1 { width: 46rem; height: 28rem; top: 16%; left: 50%; transform: translateX(-50%); opacity: 0.22; }
  .hero__g2 { display: none; }

  .hero__in { position: relative; z-index: 2; }

  .badge__mark { flex: none; color: var(--gold-flare); }

  h1 {
    margin-top: 20px;
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(2.4rem, 5.6vw, 5.125rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #fff;
    text-shadow: 0 2px 50px #000000a6;
  }
  h1 .hand {
    font-size: 1.07em;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .hero__sub {
    max-width: 45rem;
    margin: 20px auto 0;
    font-size: clamp(1.02rem, 2.1vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .hero__sub b { font-weight: 700; color: var(--gold-flare); }

  .hero .cta {
    margin-top: 2.4rem;
    min-width: min(100%, 26rem);
    padding: 1.35rem 3.75rem;
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
  }

  .facts {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin-top: 2.1rem;
    font-size: 0.82rem;
    color: #f0f0f0;
  }
  .facts li { display: inline-flex; align-items: center; gap: 5px; }
  .facts :global(svg) { color: var(--gold); flex: none; }

  /* ── Muro: tabela de travessia, conforme o nó 2722:2080 ── */
  .cross {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(1.5rem, 4vw, 3.25rem);
    width: min(100%, 58rem);
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
    align-items: stretch;
  }
  /* A quebra é decisão de leitura no desktop; no celular a linha já quebra
     sozinha e a marca atrapalharia. */
  .turn { display: none; }
  @media (min-width: 44rem) { .turn { display: inline; } }

  .cross__side { position: relative; min-width: 0; }

  .cross__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cross__head .grad { font-weight: 600; }
  .cross__head :global(svg) { flex: none; }

  .cross__side ul { display: grid; }
  .cross__side li {
    padding-block: clamp(1rem, 2.2vw, 1.45rem);
    border-bottom: 1px solid #ffffff1c;
    font-size: clamp(0.98rem, 1.9vw, 1.14rem);
    color: #8b8f9e;
  }
  .cross__side--to li { color: #fff; }

  /* A divisa: filete vertical com o portal no meio. */
  .cross__seam {
    position: relative;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--gold-deep) 12%, var(--gold) 50%, var(--gold-deep) 88%, transparent);
  }
  .cross__gate {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: #05060f;
    color: var(--gold-flare);
  }

  @media (max-width: 56rem) {
    .cross { grid-template-columns: 1fr; gap: 0; }
    .cross__seam {
      width: auto;
      height: 4.5rem;
      background: linear-gradient(90deg, transparent, var(--gold-deep) 20%, var(--gold) 50%, var(--gold-deep) 80%, transparent);
      background-size: 100% 1px;
      background-repeat: no-repeat;
      background-position: center;
    }
    .cross__gate { rotate: 90deg; }
    .cross__side--to { padding-top: 0.5rem; }
  }

  /* ── Método: texto à esquerda, degraus à direita ── */
  .method {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .method__text { text-align: left; }
  .method__text .over { text-align: left; }
  .method__text h2 {
    font-size: clamp(2.1rem, 4.6vw, 4rem);
    line-height: 1.08;
  }
  .method__lede {
    margin-top: 1.35rem;
    max-width: 34ch;
    color: var(--paper-dim);
    font-size: clamp(1rem, 2.2vw, 1.12rem);
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }

  .aside {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    max-width: 34ch;
    margin-top: 2.2rem;
    color: var(--paper-faint);
    font-size: 0.95rem;
  }
  .aside :global(svg) { color: var(--gold); flex: none; margin-top: 0.28rem; }

  /* Degraus: a barra cresce a cada fase, e a altura vem do índice. */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.6rem, 1.4vw, 1.1rem);
    align-items: stretch;
    min-height: clamp(17rem, 30vw, 23rem);
  }
  /* As colunas têm a mesma altura e o conteúdo desce até o pé; com o rótulo
     reservando duas linhas, as barras assentam todas na mesma base. */
  .steps li { display: flex; flex-direction: column; }
  /* A altura da barra é porcentagem DESTE espaço, não da coluna inteira: assim
     a de 100% chega ao topo em vez de bater no teto junto com a de 86%. */
  .steps__slot { flex: 1; display: flex; align-items: flex-end; }

  .steps__bar {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    height: var(--h);
    padding-top: clamp(1rem, 2.4vw, 1.6rem);
    border-radius: 14px 14px 4px 4px;
    color: var(--navy);
    background-image:
      linear-gradient(180deg, #ffffff40, transparent 34%),
      linear-gradient(168deg, var(--gold-flare) 0%, var(--gold) 46%, #a8863f 100%);
    box-shadow:
      inset 0 1px 0 #fff8e6cc,
      0 18px 40px -22px #d7b35666;
  }
  .steps__n {
    font-family: 'ivypresto-display', Georgia, serif;
    font-size: clamp(1.5rem, 3.4vw, 2.15rem);
    font-weight: 400;
    line-height: 1;
  }
  .steps__label {
    min-height: 2.6em;
    margin-top: 1.1rem;
    font-size: clamp(0.82rem, 1.5vw, 0.95rem);
    font-weight: 600;
    line-height: 1.3;
    color: #fff;
    text-align: center;
  }

  @media (max-width: 60rem) {
    .method { grid-template-columns: 1fr; }
    .steps { min-height: 15rem; }
  }
  @media (max-width: 34rem) {
    .steps { grid-template-columns: repeat(2, 1fr); gap: 1.6rem 0.8rem; min-height: 0; }
    .steps__slot { flex: none; }
    .steps__bar { height: auto; padding-bottom: 1.1rem; }
    .steps__label { min-height: 0; }
  }

  /* ── Sprint: painel com borda em movimento ── */
  .sprint {
    position: relative;
    margin-top: clamp(4rem, 8vw, 6.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 20px;
    background: linear-gradient(180deg, #080b23, #04050f);
    overflow: hidden;
  }
  /* A borda é um facho que dá a volta no painel. Fica na moldura, não no fundo. */
  .sprint::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background:
      conic-gradient(from var(--turn, 0deg),
        #c8a45c1f 0deg 200deg,
        var(--gold) 268deg,
        var(--gold-flare) 292deg,
        var(--gold) 316deg,
        #c8a45c1f 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: exclude;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sprint::before { animation: turn 7s linear infinite; }
  }
  @keyframes turn { to { --turn: 360deg; } }

  .sprint h3 {
    max-width: 30ch;
    margin-inline: auto;
    text-align: center;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .sprint h3 .hand { font-size: 1.08em; }

  .rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
