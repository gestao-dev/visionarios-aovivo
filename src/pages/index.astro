---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import LeadModal from '../components/LeadModal.astro';
import Bands from '../components/Bands.astro';
import Mono from '../components/Mono.astro';
import sala from '../assets/sala.jpg';
import viviane from '../assets/viviane.jpg';
import marcos from '../assets/marcos.png';

const daqui = [
  'Faturamento travado no teto',
  'Cliente que entra e sai',
  'Equipe que não anda sem você',
  'Você fazendo tudo, o dia todo',
];
const dela = [
  'Escritório lucrativo e previsível',
  'Cliente que fica e indica',
  'Time que roda sem você',
  'Você no estratégico, com liberdade',
];
const fases = [
  { icon: 'mind',  nome: 'Mentalidade & Modelo' },
  { icon: 'users', nome: 'Equipe & Estrutura' },
  { icon: 'cpu',   nome: 'Sistemas, Tech & IA' },
  { icon: 'chart', nome: 'Receita & Faturamento' },
];
const linha = ['Evento 29–30/out', 'Novembro implementa', 'Dezembro consolida', '2027 estruturado'];
const criterios = [
  'Você é dono de escritório contábil (não estudante, não iniciante)',
  'A empresa não anda sem você — e isso já te esgotou',
  'Você tem técnica de sobra, mas gestão de menos',
  'Você prefere implementar a acumular mais um curso na estante',
  'Você quer entrar em 2027 com o escritório estruturado, não no mesmo caos',
];
const vantagens = [
  { icon: 'star',      texto: 'O menor preço do evento — abre antes de todos os lotes, por 48h, e não volta.' },
  { icon: 'gift',      texto: 'Bônus físico exclusivo pra quem garantir nas primeiras 48h.' },
  { icon: 'stopwatch', texto: 'Prioridade na abertura — você é avisado primeiro, antes da lista pública.' },
  { icon: 'clapper',   texto: 'Bastidores e lineup — palestrantes e novidades em primeira mão.' },
];
---

<Base>
  <Header />

  <!-- ══ Abertura ══ -->
  <section class="hero" id="topo">
    <div class="hero__plate">
      <Image
        src={sala} alt="Visionários ao Vivo — edição anterior, sala lotada de participantes"
        widths={[720, 1200, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={82}
      />
      <div class="hero__wash"></div>
    </div>
    <span class="glow glow--gold hero__g1" aria-hidden="true"></span>
    <span class="glow glow--navy hero__g2" aria-hidden="true"></span>

    <div class="shell hero__in">
      <span class="badge"><Mono size={15} class="badge__mark" /> Visionários ao vivo 2026</span>

      <h1>Sua nova visão da contabilidade <span class="hand">começa agora.</span></h1>

      <p class="hero__sub">
        Dois dias de implementação mão na massa para o dono de escritório contábil
        reinventar o próprio negócio e <b>resolver 6 meses de estruturação em 2 dias.</b>
      </p>

      <button class="cta" type="button" data-open-lead>Garantir meu ingresso agora.</button>

      <ul class="facts">
        <li><Icon name="calendar" size={15} /> 29 e 30 de Outubro de 2026</li>
        <li><Icon name="pin" size={15} /> São Paulo</li>
        <li><Icon name="hourglass" size={15} /> 2 dias presenciais</li>
      </ul>
    </div>

  </section>

  <Bands />

  <div class="tail">
  <!-- ══ O muro ══ -->
  <section class="eyebrow-free" aria-labelledby="t-muro">
    <span class="glow glow--navy g-left" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Contador comum × Contador visionário</p>
      <h2 id="t-muro">Existe um muro entre você e o escritório que você queria ter.</h2>
      <p class="sec-lede measure center">
        A diferença entre os dois lados nunca foi técnica — é <span class="hand">visão</span>.
        O evento é o portal pra atravessar.
      </p>
    </div>

    <div class="shell duo">
      <div class="panel rise">
        <span class="medal medal--mute"><Icon name="wall" size={22} /></span>
        <h3>Do lado de cá</h3>
        <ul class="items">
          {daqui.map((t) => <li><span class="dot" aria-hidden="true"></span>{t}</li>)}
        </ul>
      </div>
      <div class="panel panel--lit rise">
        <span class="medal"><Icon name="key" size={22} /></span>
        <h3 class="lit">Do outro lado</h3>
        <ul class="items items--lit">
          {dela.map((t) => <li><Icon name="check" size={16} />{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══ Método ══ -->
  <section class="eyebrow-free" aria-labelledby="t-metodo">
    <span class="glow glow--gold g-right" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Método Aceleração Visionária · exclusivo do evento</p>
      <h2 id="t-metodo">2 dias. 6 meses de estruturação resolvidos.</h2>
      <p class="sec-lede measure center">
        4 fases, uma construída sobre a outra — cada bloco entrega uma ferramenta pronta
        pra aplicar:
      </p>
    </div>

    <ol class="shell phases">
      {fases.map((f, i) => (
        <li class="panel rise">
          <span class="medal"><Icon name={f.icon} size={24} /></span>
          <span class="phases__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{f.nome}</h3>
        </li>
      ))}
    </ol>

    <div class="shell">
      <p class="aside">
        <Icon name="star" size={17} /> + Reforma tributária como tema transversal nos dois dias.
      </p>
    </div>

    <div class="shell center sprint">
      <p class="sec-lede measure center">
        Você sai com um Sprint de 60 dias pra chegar em 2027 estruturado
      </p>
      <ol class="track">
        {linha.map((p, i) => (
          <li class={i === linha.length - 1 ? 'track__end' : ''}>
            <span class="track__pip" aria-hidden="true"></span>{p}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══ Trailer — placeholder para o vídeo 1:1 ══ -->
  <section class="eyebrow-free" aria-labelledby="t-video">
    <div class="shell center measure-wide">
      <h2 id="t-video">O que acontece na sala</h2>
    </div>
    <div class="shell reel">
      <!-- PLACEHOLDER: suba o trailer 1:1 e troque este bloco por <video poster>. -->
      <div class="reel__box panel rise">
        <span class="reel__play"><Icon name="play" size={30} /></span>
        <p>Trailer do evento · 1:1</p>
        <small>Espaço reservado — envie o arquivo e eu ligo aqui com poster e clique‑para‑tocar.</small>
      </div>
      <div class="reel__side">
        <!-- PLACEHOLDER: foto vertical da edição anterior (palco, plateia ou bastidor). -->
        <div class="shot panel rise"><span>Foto vertical<br /><small>a enviar</small></span></div>
        <div class="shot panel rise"><span>Foto vertical<br /><small>a enviar</small></span></div>
      </div>
    </div>
  </section>

  <!-- ══ Palestrantes ══ -->
  <section class="eyebrow-free" aria-labelledby="t-quem">
    <span class="glow glow--gold g-left" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Quem sobe ao palco</p>
      <h2 id="t-quem">Os palestrantes</h2>
      <p class="sec-lede measure center">
        Viviane e Marcos conduzem o método. E, a cada semana, um novo nome de peso do
        mercado contábil é revelado.
      </p>
    </div>

    <ul class="shell cast">
      <li class="panel rise">
        <div class="cast__pic"><Image src={viviane} alt="Viviane Araújo" width={420} height={420} quality={90} /></div>
        <h3>Viviane Araújo</h3>
        <p>Fundadora da Soluzzi · Mentora</p>
      </li>
      <li class="panel rise">
        <div class="cast__pic"><Image src={marcos} alt="Marcos Paulo" width={354} height={354} quality={92} /></div>
        <h3>Marcos Paulo</h3>
        <p>Contadores Visionários</p>
      </li>
      <li class="panel panel--lit rise cast__next">
        <div class="cast__pic cast__pic--void"><Icon name="star" size={30} /></div>
        <h3 class="lit">A revelar</h3>
        <p>Anunciado no grupo</p>
      </li>
    </ul>

    <div class="shell">
      <p class="aside">
        <Icon name="clapper" size={17} /> Os convidados são revelados um a um — sempre primeiro
        pra quem está na lista do Lote Zero.
      </p>
    </div>
  </section>

  <!-- ══ Qualificação ══ -->
  <section class="eyebrow-free" aria-labelledby="t-pra">
    <div class="shell center measure-wide">
      <p class="over">Antes de entrar</p>
      <h2 id="t-pra">É pra você se…</h2>
    </div>
    <div class="shell qual">
      <ul class="panel panel--lit rise">
        {criterios.map((c) => (
          <li><span class="tick"><Icon name="check" size={15} /></span><span>{c}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ Lote Zero ══ -->
  <section class="eyebrow-free" aria-labelledby="t-vant">
    <span class="glow glow--gold g-center" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">Por que entrar agora</p>
      <h2 id="t-vant">A vantagem de estar na lista</h2>
    </div>

    <div class="shell lote">
      <div class="panel panel--lit rise">
        <div class="lote__head">
          <div>
            <p class="lote__kind">Lote</p>
            <p class="lote__name hand">Zero</p>
          </div>
          <div class="lote__when">
            <span>Abre em</span>
            <strong>22 · 08</strong>
          </div>
        </div>
        <p class="lote__scope">Exclusivo pra quem está no grupo</p>

        <ul class="perks">
          {vantagens.map((v) => (
            <li><span class="medal medal--sm"><Icon name={v.icon} size={19} /></span><span>{v.texto}</span></li>
          ))}
        </ul>

        <div class="lote__act">
          <button class="cta cta--wide" type="button" data-open-lead>
            Quero o Lote Zero + bônus <Icon name="arrow" size={18} />
          </button>
          <p class="assure"><Icon name="shield" size={16} /> Vagas presenciais limitadas · 1ª edição · sala fechada</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Fechamento ══ -->
  <section class="close eyebrow-free" aria-labelledby="t-fim">
    <span class="glow glow--navy g-center" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over">A decisão</p>
      <h2 id="t-fim">Você pode entrar em 2027 igual.<br />Ou <span class="hand">atravessar o muro</span> agora.</h2>
      <p class="sec-lede measure center">
        Entre na lista do Lote Zero e seja o primeiro a garantir sua vaga na 1ª edição do
        Visionários ao Vivo — pelo menor preço, com bônus exclusivo.
      </p>
      <button class="cta cta--wide" type="button" data-open-lead>Entrar na lista do Lote Zero</button>
    </div>
  </section>

  <footer class="foot">
    <div class="shell">Visionários ao Vivo 2026 · Contadores Visionários</div>
  </footer>
  </div>

  <LeadModal />
</Base>

<style>
  .measure-wide { max-width: 46rem; }

  /* A hero termina em preto; a dobra seguinte nasce nesse mesmo preto e só
     então caminha para o azul da página. Sem isso fica a emenda visível. */
  .tail {
    background: linear-gradient(180deg, #000001 0, #01020a 14rem, var(--ground) 34rem);
    background-repeat: no-repeat;
  }

  /* Linha curta acima do título: centralizada e destacada como rótulo do bloco,
     não empilhada como rótulo de formulário. */
  .over {
    margin-bottom: 1.1rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--gold);
  }

  /* ── Abertura: reconstruída a partir do arquivo do cliente ── */
  .hero {
    position: relative;
    padding-block: clamp(8rem, 22vh, 15rem) clamp(11rem, 22vw, 19rem);
    isolation: isolate;
    overflow: clip;
    text-align: center;
  }
  .hero__plate { position: absolute; inset: 0; z-index: -2; isolation: isolate; }
  .hero__plate :global(img) {
    position: relative; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 28%;
    filter: saturate(0.9) contrast(1.02) brightness(0.86);
  }
  /* Escurecimento vertical até o preto, como no arquivo. */
  .hero__wash {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, #00000108 0%, #00000159 46%, #000001 87%),
      radial-gradient(78% 52% at 50% 46%, #0000005c 0%, #000001b3 100%);
  }
  .hero__g1 { width: 46rem; height: 28rem; top: 16%; left: 50%; transform: translateX(-50%); opacity: 0.22; }
  .hero__g2 { display: none; }

  .hero__in { position: relative; z-index: 2; }

  .badge__mark { flex: none; color: var(--gold-flare); }

  h1 {
    margin-top: 2.6rem;
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(2.4rem, 5.6vw, 5.125rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.05em;
    color: #fff;
    text-shadow: 0 2px 50px #000000a6;
  }
  h1 .hand {
    font-size: 1.07em;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .hero__sub {
    max-width: 45rem;
    margin: 1.9rem auto 0;
    font-size: clamp(1.02rem, 2.1vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .hero__sub b { font-weight: 700; color: var(--gold-flare); }

  .hero .cta {
    margin-top: 2.4rem;
    min-width: min(100%, 26rem);
    padding: 1.35rem 3.75rem;
    border-radius: 8px;
    background-image: linear-gradient(90deg, var(--gold) 0%, var(--gold-flare) 100%);
    color: var(--navy);
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
    letter-spacing: -0.009em;
    text-transform: uppercase;
  }

  .facts {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin-top: 2.1rem;
    font-size: 0.82rem;
    color: #f0f0f0;
  }
  .facts li { display: inline-flex; align-items: center; gap: 5px; }
  .facts :global(svg) { color: var(--gold); flex: none; }

  /* ── Muro ── */
  .duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
    margin-top: 3.2rem;
  }
  .duo h3 { margin-top: 1.15rem; font-size: 1.3rem; }
  .medal--mute { color: var(--paper-faint); background: #ffffff0d; box-shadow: inset 0 1px 0 #ffffff14; }
  .items { margin-top: 1.4rem; display: grid; gap: 0.9rem; }
  .items li {
    display: grid; grid-template-columns: 1.15rem 1fr; gap: 0.85rem;
    align-items: start; color: var(--paper-dim);
  }
  .items :global(svg) { color: var(--gold); margin-top: 0.34rem; }
  .items--lit li { color: var(--paper); }
  .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--paper-faint); margin-top: 0.62rem; margin-left: 0.25rem;
  }

  /* ── Fases ── */
  .phases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
    margin-top: 3.2rem;
  }
  .phases li { position: relative; }
  .phases__n {
    position: absolute; top: clamp(1.5rem, 3.4vw, 2.4rem); right: clamp(1.5rem, 3.4vw, 2.4rem);
    font-size: 1.5rem; font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #ffffff14;
  }
  .phases h3 { margin-top: 2rem; font-size: 1.18rem; }

  .aside {
    display: flex; align-items: flex-start; gap: 0.7rem;
    max-width: var(--measure); margin: 2.6rem auto 0;
    color: var(--paper-faint); font-size: 0.95rem;
  }
  .aside :global(svg) { color: var(--gold); flex: none; margin-top: 0.28rem; }

  /* ── Sprint ── */
  .sprint { margin-top: 3.4rem; }
  .track {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem; margin-top: 1.8rem;
  }
  .track li {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.95rem 1.15rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #ffffff0d, #ffffff03);
    box-shadow: inset 0 1px 0 #ffffff12;
    font-size: 0.92rem; color: var(--paper-dim);
  }
  .track__pip { width: 7px; height: 7px; border-radius: 50%; background: var(--gold-deep); flex: none; }
  .track__end { color: var(--gold-lift); box-shadow: inset 0 1px 0 #e6cd9130, 0 0 0 1px #c8a45c33; }
  .track__end .track__pip { background: var(--gold-lift); }

  /* ── Trailer + fotos ── */
  .reel {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem); margin-top: 2.8rem;
  }
  .reel__box {
    display: grid; place-content: center; justify-items: center; gap: 0.6rem;
    aspect-ratio: 16 / 10; text-align: center; color: var(--paper-faint);
  }
  .reel__play {
    display: grid; place-items: center;
    width: 4.5rem; height: 4.5rem; border-radius: 50%;
    color: var(--gold-lift);
    background: linear-gradient(180deg, #c8a45c2b, #c8a45c0d);
    box-shadow: inset 0 1px 0 #e6cd9130;
  }
  .reel__box p { color: var(--paper-dim); font-weight: 500; }
  .reel__box small { max-width: 26ch; font-size: 0.8rem; line-height: 1.5; }
  .reel__side { display: grid; gap: clamp(1rem, 2vw, 1.4rem); }
  .shot {
    display: grid; place-items: center; text-align: center;
    min-height: 8rem; color: var(--paper-faint); font-size: 0.86rem;
  }
  .shot small { opacity: 0.7; }
  @media (max-width: 52rem) {
    .reel { grid-template-columns: 1fr; }
    .reel__side { grid-template-columns: 1fr 1fr; }
  }

  /* ── Elenco ── */
  .cast {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem); margin-top: 3.2rem;
    text-align: center;
  }
  .cast__pic {
    position: relative;
    width: clamp(7rem, 16vw, 9.5rem); aspect-ratio: 1;
    margin: 0 auto 1.4rem;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px #c8a45c3d, 0 18px 40px -18px #000, inset 0 0 30px #00000059;
  }
  .cast__pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cast__pic--void {
    display: grid; place-items: center;
    color: var(--gold-lift);
    background: linear-gradient(180deg, #c8a45c1f, #c8a45c08);
  }
  .cast h3 { font-size: 1.22rem; }
  .cast p { margin-top: 0.45rem; color: var(--paper-faint); font-size: 0.9rem; }

  /* ── Qualificação ── */
  .qual { margin-top: 3rem; max-width: 50rem; }
  .qual ul { display: grid; gap: 1.15rem; }
  .qual li { display: grid; grid-template-columns: 1.7rem 1fr; gap: 1rem; align-items: start; color: var(--paper-dim); }
  .tick {
    display: grid; place-items: center;
    width: 1.7rem; height: 1.7rem; border-radius: 50%;
    color: var(--gold-lift);
    background: linear-gradient(180deg, #c8a45c33, #c8a45c0f);
    box-shadow: inset 0 1px 0 #e6cd9130;
  }

  /* ── Lote ── */
  .lote { margin-top: 3rem; max-width: 52rem; }
  .lote__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .lote__kind { font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--paper-faint); }
  .lote__name { font-size: clamp(2.6rem, 7vw, 4rem); line-height: 1; }
  .lote__when { text-align: right; }
  .lote__when span { display: block; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--paper-faint); }
  .lote__when strong { font-size: 1.7rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--gold-lift); }
  .lote__scope { margin-top: 0.6rem; color: var(--paper-faint); font-size: 0.9rem; }
  .perks { margin-top: 2.2rem; display: grid; gap: 1.35rem; }
  .perks li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; color: var(--paper-dim); }
  .perks li:first-child { color: var(--paper); }
  .medal--sm { width: 2.4rem; height: 2.4rem; border-radius: 10px; }
  .lote__act { margin-top: 2.6rem; text-align: center; }

  /* ── Fechamento ── */
  .close { padding-bottom: clamp(5.5rem, 11vw, 9rem); }
  .close h2 { font-size: clamp(2rem, 5.2vw, 3.4rem); }
  .close .cta { margin-top: 2.6rem; }

  /* Halos de seção */
  .g-left   { width: 34rem; height: 24rem; top: 6%; left: -14rem; opacity: 0.32; }
  .g-right  { width: 34rem; height: 24rem; top: 10%; right: -14rem; opacity: 0.28; }
  .g-center { width: 42rem; height: 26rem; top: 18%; left: 50%; transform: translateX(-50%); opacity: 0.3; }

  .foot {
    padding-block: 2.4rem;
    color: var(--paper-faint); font-size: 0.82rem; text-align: center;
    box-shadow: inset 0 1px 0 #ffffff0d;
  }
</style>
