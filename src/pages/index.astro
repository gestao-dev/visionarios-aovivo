---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import LeadModal from '../components/LeadModal.astro';
import Bands from '../components/Bands.astro';
import Dock from '../components/Dock.astro';
import heroSala from '../assets/hero-sala.png';
import heroSalaMobile from '../assets/hero-sala-mobile.png';
import cardViviane from '../assets/card-viviane.png';
import cardMarcos from '../assets/card-marcos.png';
import cardConvidado1 from '../assets/card-convidado-1.png';
import cardConvidado2 from '../assets/card-convidado-2.png';
import ticket from '../assets/ticket-lote-zero.png';
import fecho from '../assets/fecho.png';
import pilares from '../assets/pilares.png';
import pilaresMobile from '../assets/pilares-mobile.png';
import ticketMobile from '../assets/ticket-lote-zero-mobile.png';

// Direção de arte na abertura: o celular recebe um enquadramento próprio, e o
// <picture> garante que só um dos dois seja baixado.
const heroLargo = await getImage({ src: heroSala, widths: [720, 1200, 1920], format: 'webp', quality: 82 });
const heroEstreito = await getImage({ src: heroSalaMobile, widths: [430, 760, 1043], format: 'webp', quality: 86 });
const pilaresLargo = await getImage({ src: pilares, widths: [960, 1440, 1920], format: 'webp', quality: 92 });
const pilaresEstreito = await getImage({ src: pilaresMobile, widths: [430, 760, 980], format: 'webp', quality: 90 });
const ticketLargo = await getImage({ src: ticket, widths: [430, 858], format: 'webp', quality: 88 });
const ticketEstreito = await getImage({ src: ticketMobile, widths: [430, 700, 1024], format: 'webp', quality: 90 });

const daqui = [
  'Faturamento travado no teto',
  'Cliente que entra e sai',
  'Equipe que não anda sem você',
  'Você fazendo tudo, o dia todo',
];
const dela = [
  'Escritório lucrativo e previsível',
  'Cliente que fica e indica',
  'Time que roda sem você',
  'Você no estratégico, com liberdade',
];
const sprint = [
  { quando: 'Evento',   linhas: ['29 e 30', 'de Outubro'] },
  { quando: 'Novembro', linhas: ['implementa'] },
  { quando: 'Dezembro', linhas: ['consolida'] },
  { quando: '2027',     linhas: ['estruturado'] },
];
const elenco = [
  { img: cardViviane,    alt: 'Viviane Araújo, fundadora da Soluzzi e mentora' },
  { img: cardMarcos,     alt: 'Marcos Paulo, Contadores Visionários' },
  { img: cardConvidado1, alt: 'Palestrante a revelar, anunciado no grupo' },
  { img: cardConvidado2, alt: 'Palestrante a revelar, anunciado no grupo' },
];
const criterios = [
  'Você é dono de escritório contábil (não estudante, não iniciante)',
  'O escritório não anda sem você, e isso já te esgotou',
  'Você tem técnica de sobra, mas gestão de menos',
  'Sofre com gestão e mão de obra qualificada',
  'Você quer entrar em 2027 com o escritório estruturado, não no mesmo caos',
];
const vantagens = [
  { icon: 'star',      texto: 'O menor preço do evento: abre antes de todos os lotes, por 48h, e não volta.' },
  { icon: 'gift',      texto: 'Bônus físico exclusivo pra quem garantir nas primeiras 48h.' },
  { icon: 'stopwatch', texto: 'Prioridade na abertura: você é avisado primeiro, antes da lista pública.' },
  { icon: 'clapper',   texto: 'Bastidores: palestrantes e novidades em primeira mão.' },
];
---

<Base>
  <Header />

  <!-- ══ Abertura ══ -->
  <section class="hero" id="topo">
    <div class="hero__plate">
      <picture>
        <source media="(max-width: 46rem)" type="image/webp"
                srcset={heroEstreito.srcSet.attribute} sizes="100vw" />
        <img src={heroLargo.src} srcset={heroLargo.srcSet.attribute} sizes="100vw"
             width={1920} height={1027} loading="eager" fetchpriority="high" decoding="async"
             alt="Visionários ao Vivo, edição anterior, sala lotada de participantes" />
      </picture>
      <div class="hero__wash"></div>
    </div>
    <span class="glow glow--gold hero__g1" aria-hidden="true"></span>
    <span class="glow glow--navy hero__g2" aria-hidden="true"></span>

    <div class="shell hero__in stagger">
      <span class="badge">
        <!-- Ponto vivo do arquivo do cliente: halo translúcido e miolo cheio. -->
        <svg class="badge__mark" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" focusable="false">
          <circle cx="7.5" cy="7.5" r="7.5" fill="#FF0000" fill-opacity="0.5" />
          <circle cx="7.5" cy="7.5" r="5.19231" fill="#FF2828" />
        </svg>
        Visionários ao vivo 2026
      </span>

      <h1>Sua nova visão da contabilidade <span class="hand">começa agora.</span></h1>

      <p class="hero__sub">
        Dois dias de implementação mão na massa para o dono de escritório contábil
        reinventar o próprio negócio e <b>resolver 6 meses de estruturação em 2 dias.</b>
      </p>

      <button class="cta" type="button" data-open-lead>Entrar na lista do Lote Zero</button>

      <ul class="facts">
        <li><Icon name="calendar" size={15} /> 29 e 30 de Outubro de 2026</li>
        <li><Icon name="pin" size={15} /> São Paulo</li>
        <li><Icon name="hourglass" size={15} /> 2 dias presenciais</li>
      </ul>
    </div>

  </section>

  <Bands />

  <div class="tail">
  <!-- ══ O muro ══ -->
  <section id="dobra-2" class="eyebrow-free" aria-labelledby="t-muro">
    <span class="glow glow--navy g-left" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over fade">Contador comum × Contador visionário</p>
      <h2 id="t-muro" class="rise">Existe um muro <span class="grad">entre você e o escritório</span> que você queria ter.</h2>
      <p class="sec-lede measure center rise">
        A diferença entre os dois lados nunca foi técnica: é visão.<br class="turn" />
        O evento é o portal pra atravessar.
      </p>
    </div>

    <div class="shell cross">
      <div class="cross__side stagger">
        <p class="cross__head"><Icon name="wall" size={16} /> <span class="grad">Do lado de cá</span></p>
        <ul class="stagger">{daqui.map((t) => <li>{t}</li>)}</ul>
      </div>

      <div class="cross__seam zoom" aria-hidden="true">
        <span class="cross__gate"><Icon name="arrow" size={20} /></span>
      </div>

      <div class="cross__side cross__side--to stagger">
        <p class="cross__head cross__head--to"><Icon name="key" size={16} /> <span class="grad">Do outro lado</span></p>
        <ul class="stagger">{dela.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ══ Método ══ -->
  <section aria-labelledby="t-metodo">
    <span class="glow glow--gold g-right" aria-hidden="true"></span>

    <!-- Os quatro pilares vêm desenhados na arte: o texto mora na metade
         esquerda, que no arquivo é preta de propósito. -->
    <div class="pilares">
      <div class="shell method">
        <div class="method__text stagger">
          <p class="over over--metodo">Método Aceleração Visionária<span class="sep"> · </span><br class="turn-m" />exclusivo do evento</p>
          <h2 id="t-metodo" class="h-lg">
            2 dias. 6 meses<br class="turn" />
            de <span class="hand grad">estruturação</span><br class="turn" />
            <span class="hand grad">resolvidos.</span>
          </h2>
          <p class="method__lede">
            4 fases, uma construída sobre a outra,<br class="turn" />
            e cada bloco entrega uma ferramenta pra aplicar:
          </p>
          <p class="aside">
            <span class="medal medal--sm"><Icon name="star" size={19} /></span>
            <span>+ Reforma tributária como tema transversal nos dois dias.</span>
          </p>
        </div>
      </div>

      <!-- Depois do texto no documento: no desktop ela é absoluta e o lugar
           não importa; no celular ela vira faixa e cai embaixo, onde deve. -->
      <div class="pilares__plate fade" aria-hidden="true">
        <picture>
          <source media="(max-width: 62rem)" type="image/webp"
                  srcset={pilaresEstreito.srcSet.attribute} sizes="100vw" />
          <img src={pilaresLargo.src} srcset={pilaresLargo.srcSet.attribute} sizes="100vw"
               width={1920} height={735} alt="" loading="lazy" decoding="async" />
        </picture>
      </div>
    </div>

    <div class="shell">
      <div class="sprint rise">
        <h3 class="rise">
          Você sai com um<br class="turn" />
          <span class="hand">Sprint de 60 dias</span> pra chegar<br class="turn" />
          em 2027 estruturado
        </h3>

        <ol class="rail stagger">
          {sprint.map((e, i) => (
            <li class={i === sprint.length - 1 ? 'rail--now' : ''}>
              <span class="rail__dot" aria-hidden="true"></span>
              <b>{e.quando}</b>
              <span>{e.linhas.map((l, n) => (n === 0 ? l : [<br class="turn" />, ' ', l]))}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ══ Palestrantes ══ -->
  <section aria-labelledby="t-quem">
    <span class="glow glow--gold g-left" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over fade">Quem sobe ao palco</p>
      <h2 id="t-quem" class="grad h-lg rise">Os palestrantes</h2>
      <p class="sec-lede measure center rise">
        Viviane e Marcos conduzem o método. E, a cada semana, um novo nome de peso do
        mercado contábil é revelado.
      </p>
    </div>

    <ul class="shell cast stagger">
      {elenco.map((e) => (
        <li class="cast__card">
          <Image src={e.img} alt={e.alt} widths={[320, 619]}
                 sizes="(max-width: 46rem) calc(100vw - 40px), (max-width: 62rem) 45vw, 17rem"
                 quality={88} />
        </li>
      ))}
    </ul>

    <div class="shell">
      <p class="aside aside--note fade">
        Os convidados são revelados um a um, sempre primeiro pra quem<br class="turn" />
        está na lista do Lote Zero.
      </p>
    </div>
  </section>

  <!-- ══ Qualificação ══ -->
  <section aria-labelledby="t-pra">
    <div class="shell center measure-wide">
      <p class="over fade">Antes de entrar</p>
      <h2 id="t-pra" class="h-lg rise">É pra você se…</h2>
    </div>
    <ul class="shell bento stagger">
      {criterios.map((c) => (
        <li class="card">
          <span class="medal medal--sm"><Icon name="check" size={18} /></span>
          <p>{c}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ══ Lote Zero ══ -->
  <section class="eyebrow-free" aria-labelledby="t-vant">
    <span class="glow glow--gold g-center" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over fade">Por que entrar agora</p>
      <h2 id="t-vant" class="rise">A vantagem de estar na lista</h2>
    </div>

    <div class="shell lote">
      <div class="card lote__frame rise">
        <div class="lote__art from-l">
          <picture>
            <source media="(max-width: 60rem)" type="image/webp"
                    srcset={ticketEstreito.srcSet.attribute} sizes="80vw" />
            <img src={ticketLargo.src} srcset={ticketLargo.srcSet.attribute} sizes="24rem"
                 width={858} height={1462} loading="lazy" decoding="async"
                 alt="Ingresso Lote Zero do Visionários ao Vivo, com Viviane Araújo e Marcos Paulo" />
          </picture>
        </div>

        <div class="lote__side from-r">
          <div class="lote__head stagger">
            <img class="lote__logo" src="/logo-visionarios-ao-vivo.svg"
                 alt="Visionários ao Vivo" width="196" height="48" />
            <span class="tag">Lote Zero</span>
          </div>

          <ul class="perks stagger">
            {vantagens.map((v) => (
              <li><span class="medal medal--sm"><Icon name={v.icon} size={19} /></span><span>{v.texto}</span></li>
            ))}
          </ul>

          <div class="lote__act rise">
            <button class="cta cta--wide" type="button" data-open-lead>
              Quero o Lote Zero + bônus <Icon name="arrow" size={18} />
            </button>

            <div class="tick" role="timer" aria-live="off">
              <span class="tick__tag">Faltam:</span>
              <div class="tick__boxes">
                <div class="tick__box"><b data-u="d">00</b><span>DIAS</span></div>
                <div class="tick__box"><b data-u="h">00</b><span>HORAS</span></div>
                <div class="tick__box"><b data-u="m">00</b><span>MIN</span></div>
                <div class="tick__box"><b data-u="s">00</b><span>SEG</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Fechamento ══ -->
  <section class="close eyebrow-free" aria-labelledby="t-fim">
    <div class="close__plate" aria-hidden="true">
      <Image src={fecho} alt="" widths={[960, 1440, 1920]} sizes="100vw" quality={95} />
    </div>
    <span class="glow glow--navy g-center" aria-hidden="true"></span>
    <div class="shell center measure-wide">
      <p class="over fade">A decisão</p>
      <h2 id="t-fim" class="rise">
        Você pode entrar em 2027 igual.<br />
        <span class="hand">Ou atravessar o muro agora.</span>
      </h2>
      <p class="sec-lede close__lede center rise">
        Entre na lista do Lote Zero e seja o primeiro a garantir sua vaga na 1ª edição<br class="turn" />
        do Visionários ao Vivo, pelo menor preço, com bônus exclusivo.
      </p>
      <button class="cta cta--wide rise" type="button" data-open-lead>Entrar na lista do Lote Zero</button>
    </div>
  </section>

  <footer class="foot">
    <div class="shell fade">Visionários ao Vivo 2026 · Contadores Visionários</div>
  </footer>
  </div>

  <Dock />
  <LeadModal />
</Base>

<style>
  .measure-wide { max-width: 46rem; }

  /* A hero termina em preto; a dobra seguinte nasce nesse mesmo preto e só
     então caminha para o azul da página. Sem isso fica a emenda visível. */
  /* A arte da abertura termina na própria cor da página, então aqui não há
     transição a fazer. */
  .tail { background: var(--ground); }

  /* Linha curta acima do título: centralizada e destacada como rótulo do bloco,
     não empilhada como rótulo de formulário. */
  /* Proximidade: o rótulo pertence ao título, então encosta nele. */
  .over {
    margin-bottom: 0.77rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-flare);
  }

  /* ── Abertura: reconstruída a partir do arquivo do cliente ── */
  /* O conteúdo mora no rodapé da dobra: a altura é a da tela menos o header,
     e o bloco encosta embaixo. Assim ele fica lá no pé como na referência
     sem que a ação caia abaixo da dobra em tela baixa. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: calc(100svh - 95px);
    padding-block: clamp(6rem, 14vh, 10rem) clamp(3.5rem, 7vw, 6rem);
    isolation: isolate;
    overflow: clip;
    text-align: center;
  }
  @media (max-width: 44rem) { .hero { min-height: calc(100svh - 76px); } }
  /* No celular a foto não cobre a dobra: vira faixa no topo, na proporção
     dela, e o véu a dissolve no preto antes do selo. */
  @media (max-width: 46rem) {
    .hero__plate { bottom: auto; height: auto; aspect-ratio: 1920 / 1027; }
    .hero__wash {
      background: linear-gradient(180deg, #041e4214 0%, #041e426b 46%, var(--ground) 100%);
    }
  }
  .hero__plate { position: absolute; inset: 0; z-index: -2; isolation: isolate; }
  /* Ancorada embaixo: é onde a plateia está, e é o que não pode ser cortado. */
  .hero__plate :global(img) {
    position: relative; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center bottom;
    filter: saturate(0.9) contrast(1.02) brightness(0.86);
  }
  /* Escurecimento vertical até o preto, como no arquivo. */
  .hero__wash {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, #041e4208 0%, #041e4259 46%, var(--ground) 90%),
      radial-gradient(78% 52% at 50% 46%, #041e425c 0%, #041e42b3 100%);
  }
  .hero__g1 { width: 46rem; height: 28rem; top: 16%; left: 50%; transform: translateX(-50%); opacity: 0.22; }
  .hero__g2 { display: none; }

  .hero__in { position: relative; z-index: 2; }

  .badge__mark { flex: none; color: var(--gold-flare); }

  h1 {
    margin-top: 12px;
    max-width: 20ch;
    margin-inline: auto;
    font-size: clamp(3rem, 5.6vw, 5.125rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--paper);
    text-shadow: 0 2px 50px #000000a6;
  }
  h1 .hand {
    font-size: 1.07em;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .hero__sub {
    max-width: 45rem;
    margin: 12px auto 0;
    font-size: clamp(1.02rem, 2.1vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--paper);
  }
  .hero__sub b { font-weight: 700; color: var(--gold-flare); }

  .hero .cta {
    margin-top: 20px;
    min-width: min(100%, 26rem);
    padding: 1.35rem 3.75rem;
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
  }

  .facts {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin-top: 12px;
    font-size: 0.82rem;
    color: #f0f0f0;
  }
  .facts li { display: inline-flex; align-items: center; gap: 5px; }
  .facts :global(svg) { color: var(--gold); flex: none; }

  /* ── Muro: tabela de travessia, conforme o nó 2722:2080 ── */
  .cross {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(1.5rem, 4vw, 3.25rem);
    max-width: 58rem;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
    align-items: stretch;
  }
  /* A quebra é decisão de leitura no desktop; no celular a linha já quebra
     sozinha e a marca atrapalharia. */
  .turn { display: none; }
  @media (min-width: 44rem) { .turn { display: inline; } }
  /* Espelho de .turn: quebra que só vale no celular. */
  .turn-m { display: inline; }
  @media (min-width: 44rem) { .turn-m { display: none; } }
  @media (max-width: 44rem) { .over--metodo .sep { display: none; } }

  .cross__side { position: relative; min-width: 0; }

  .cross__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cross__head .grad { font-weight: 600; }
  .cross__head :global(svg) { flex: none; }

  .cross__side ul { display: grid; }
  .cross__side li {
    padding-block: clamp(1rem, 2.2vw, 1.45rem);
    border-bottom: 1px solid #ffffff1c;
    font-size: clamp(0.98rem, 1.9vw, 1.14rem);
    color: var(--paper);
  }
  .cross__side--to li { color: var(--paper); }

  /* A divisa: filete vertical com o portal no meio. */
  .cross__seam {
    position: relative;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--gold-deep) 12%, var(--gold) 50%, var(--gold-deep) 88%, transparent);
  }
  .cross__gate {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--ground);
    color: var(--gold-flare);
  }

  /* Celular: a lista centrada e as divisórias na mesma medida curta, em vez
     de filetes de ponta a ponta da tela. */
  @media (max-width: 46rem) {
    .cross__side ul { width: min(100%, 17rem); margin-inline: auto; }
    .cross__side li { text-align: center; }
    .cross__head { justify-content: center; }
  }
  @media (max-width: 56rem) {
    .cross { grid-template-columns: 1fr; gap: 0; }
    .cross__seam {
      width: auto;
      height: 4.5rem;
      background: linear-gradient(90deg, transparent, var(--gold-deep) 20%, var(--gold) 50%, var(--gold-deep) 80%, transparent);
      background-size: 100% 1px;
      background-repeat: no-repeat;
      background-position: center;
    }
    .cross__gate { rotate: 90deg; }
    .cross__side--to { padding-top: 0.5rem; }
  }

  /* ── Método: texto à esquerda, degraus à direita ── */
  /* Itálica de display em regular; o .grad traz 700 e aqui ele não serve. */
  .method__text h2 .hand {
    font-weight: 400;
    font-size: 1.04em;
    letter-spacing: -0.02em;
  }
  .method__lede {
    margin-top: 1.35rem;
    color: var(--paper);
    font-size: clamp(1rem, 2.2vw, 1.12rem);
    line-height: 1.5;
  }

  /* Nota com a mesma placa de ícone da dobra do preço. */
  .aside {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
    max-width: 34ch;
    margin-top: 2.2rem;
    color: var(--paper);
    font-size: 0.95rem;
  }

  /* ── Pilares: a arte é a dobra inteira, o texto ocupa a metade escura ── */
  /* A altura acompanha a proporção da arte, com teto nos 735px de origem:
     assim ela nunca é ampliada e o enquadramento dos pilares é o mesmo em
     qualquer largura. */
  .pilares {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(51vw, 735px);
  }
  .pilares__plate { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .pilares__plate :global(img) {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  /* Filetes de 4px no gradiente da marca fecham a faixa em cima e embaixo:
